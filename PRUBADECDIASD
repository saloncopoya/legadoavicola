// Función para formatear anillo a 3 dígitos (ej: 1 → 001, 12 → 012, 432 → 432)
window.formatearAnillo = (input) => {
    if (!input) return;
    let valor = input.value.trim();
    if (valor === '') return;
    let numero = parseInt(valor, 10);
    if (isNaN(numero)) {
        input.value = '';
        return;
    }
    // Formatear a 3 dígitos con ceros a la izquierda
    input.value = numero.toString().padStart(3, '0');
};

