window.generarPDFPublic = function(torneoId, torneoNombre) {
    // Buscar la tarjeta completa del torneo
    const tituloElement = document.querySelector(`#torneo-${torneoId}`);
    if (!tituloElement) {
        if (window.AppState) AppState.addNotification('❌ No se encontró el torneo', 'error');
        return;
    }
    
    let tarjetaCompleta = tituloElement.closest('div[style*="margin-bottom: 60px;"]');
    if (!tarjetaCompleta) tarjetaCompleta = tituloElement.closest('div[style*="background: white"]');
    if (!tarjetaCompleta) return;

    // ===== DETECTAR QUÉ PESTAÑA ESTÁ ACTIVA =====
    let esCotejo = false;
    let esPosicion = false;
    
    const botonesPestanas = tarjetaCompleta.querySelectorAll('button[onclick*="cambiarPestanaPublic"]');
    botonesPestanas.forEach(btn => {
        const estiloBg = btn.style.background || window.getComputedStyle(btn).background;
        if (estiloBg.includes('#8B4513') || estiloBg.includes('139, 69, 19')) {
            if (btn.textContent.includes('COTEJO')) esCotejo = true;
            if (btn.textContent.includes('POSICIONES')) esPosicion = true;
        }
    });
    
    if (!esCotejo && !esPosicion) esCotejo = true;
    const tipoContenido = esCotejo ? 'COTEJO' : 'POSICIONES';
    console.log(`📄 Generando PDF de: ${tipoContenido}`);
    
    // ===== CLONAR LA TARJETA COMPLETA =====
    const clone = tarjetaCompleta.cloneNode(true);
    
    // Eliminar botones de acción
    const botonesAccion = clone.querySelectorAll('button');
    botonesAccion.forEach(btn => {
        if (btn.textContent.includes('VER') || btn.textContent.includes('COMPARTIR')) btn.remove();
    });
    
    // Eliminar el indicador de "DATOS EN TIEMPO REAL"
    const indicadorTiempo = clone.querySelector('div[style*="padding: 8px 16px; background: #f0f8ff"]');
    if (indicadorTiempo) indicadorTiempo.remove();
    
    // ===== OCULTAR LA PESTAÑA QUE NO ESTÁ ACTIVA =====
    const contenedorPestanas = clone.querySelector('div[style*="display: flex; gap: 12px; justify-content: center"]');
    if (contenedorPestanas) {
        const botones = contenedorPestanas.querySelectorAll('button');
        botones.forEach(btn => {
            if (esCotejo && btn.textContent.includes('POSICIONES')) btn.style.display = 'none';
            if (esPosicion && btn.textContent.includes('COTEJO')) btn.style.display = 'none';
        });
    }
    
    // ===== MOSTRAR SOLO EL CONTENIDO DE LA PESTAÑA ACTIVA =====
    const contenedoresContenido = clone.querySelectorAll('div[style*="overflow-x: auto;"]');
    contenedoresContenido.forEach(contenedor => {
        const tablas = contenedor.querySelectorAll('table');
        tablas.forEach(tabla => {
            const esTablaPosicion = tabla.textContent.includes('Partido') && tabla.textContent.includes('Puntos');
            if (esPosicion && esTablaPosicion) tabla.style.display = 'table';
            else if (esCotejo && !esTablaPosicion) tabla.style.display = 'table';
            else tabla.style.display = 'none';
        });
    });
    
    // LOGO URL
    const logoUrl = 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi0T3uNTRD3YcwGAC4QM6ZJg_ylxluOI6yCOVTW4yf1hhgK4qP6rl8aF1INqcVBJ-2ph5U9w-FV67mUY8sGGheW7AQ3x00fZz3SyG7Kt0b3sxGE0G3G578DgZAWW8-Z-GWXCSK_6Iyoe0QP41AMCBfdKtwqxs0aXjVoAvqYV7_oxBBvuUW18I5Az01uDBup/s1024/abrir.jpg';
