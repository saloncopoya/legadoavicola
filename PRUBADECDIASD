      sessionStorage.removeItem('lastScreen');
      sessionStorage.removeItem('pendingLogin');
      sessionStorage.removeItem('postActivationIntent');
      
      // Redirigir a public SIN ningún recuerdo
      window.history.pushState({}, '', '/');
      
      // Forzar que no haya modales
      setTimeout(() => {
        window.modalGoogleActivo = false;
