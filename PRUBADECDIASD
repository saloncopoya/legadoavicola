// Ofuscación de correos electrónicos mejorada (Base64) - EJECUCIÓN INMEDIATA
(function() {
  'use strict';
  
  // Función para codificar un email a Base64 (usando btoa, que funciona con ASCII)
  function encodeEmailToBase64(email) {
    try {
      // btoa solo funciona con caracteres ASCII (estándar). Los emails suelen serlo.
      return btoa(email);
    } catch (e) {
      console.warn('No se pudo codificar un email:', email);
      return email; // Si falla, devolvemos el original para no romper la página
    }
  }

  // Función principal de ofuscación que procesa un nodo y sus hijos
  function obfuscateEmailsInNode(node) {
    // Si es un nodo de texto, procesamos su contenido
    if (node.nodeType === Node.TEXT_NODE) {
      // Expresión regular para encontrar emails
      // Esta es una versión simple. Para una más precisa, se puede complicar mucho.
      const emailRegex = /([a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\.[a-zA-Z0-9._-]+)/gi;
      let match;
      let lastIndex = 0;
      let newContent = '';
      let modified = false;

      // Reiniciamos el regex por si acaso
      emailRegex.lastIndex = 0;

      // Buscamos todas las ocurrencias de email en el texto del nodo
      while ((match = emailRegex.exec(node.textContent)) !== null) {
        modified = true;
        // Añadimos el texto antes del email
        newContent += node.textContent.substring(lastIndex, match.index);
        // Añadimos el email codificado
        newContent += encodeEmailToBase64(match[0]);
        lastIndex = match.index + match[0].length;
      }
      
      // Si se modificó, actualizamos el contenido del nodo de texto
      if (modified) {
        newContent += node.textContent.substring(lastIndex);
        node.textContent = newContent;
      }
    } 
    // Si es un nodo elemento, procesamos recursivamente sus hijos, excluyendo scripts, estilos e iframes
    else if (node.nodeType === Node.ELEMENT_NODE) {
      // No procesar scripts, estilos, ni iframes para evitar romper funcionalidades
      const tagName = node.tagName;
      if (tagName !== 'SCRIPT' && tagName !== 'STYLE' && tagName !== 'IFRAME') {
        // Convertimos la lista de hijos a un array para evitar problemas si la lista se modifica durante el bucle
        const childNodes = Array.from(node.childNodes);
        for (let i = 0; i < childNodes.length; i++) {
          obfuscateEmailsInNode(childNodes[i]);
        }
      }
    }
  }

  // Ejecutar la ofuscación inmediatamente, ANTES de que el navegador termine de construir el DOM
  console.log('🔐 Iniciando ofuscación de emails...');
  try {
    obfuscateEmailsInNode(document.body);
    console.log('✅ Ofuscación completada.');
  } catch (e) {
    console.error('❌ Error durante la ofuscación:', e);
  }
})();
