// ==============================================
function esVisorInterno() {
    const ua = navigator.userAgent || navigator.vendor || window.opera;
    
    // Detectar Facebook e Instagram
    const isFacebook = ua.includes('FBAN') || ua.includes('FBAV') || ua.includes('Instagram');
    
    // Detectar WebView en general
    const isWebView = /; wv\)/.test(ua) || ua.includes('wv');
    
    return isFacebook || isWebView;
}

