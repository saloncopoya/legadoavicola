        .child('peleas')
        .child(peleaIndex);
    
    // Si ya estaba seleccionado (verde) → pedir confirmación para eliminar
    if (isSelected) {
        const confirmar = confirm(`⚠️ ¿Eliminar el vallín ${vallinNum} de esta pelea?`);
        if (!confirmar) return;
        
        // Eliminar vallín
        await peleaRef.child('vallin').remove();
        
        // Actualizar estado local
        if (calificacionesCargadas.has(peleaIndex)) {
            const cal = calificacionesCargadas.get(peleaIndex);
            delete cal.vallin;
            calificacionesCargadas.set(peleaIndex, cal);
        } else {
            // Si no había calificación, creamos un objeto temporal
            calificacionesCargadas.set(peleaIndex, { vallin: null });
        }
        
        // Cambiar UI del botón a rojo
        btn.style.backgroundColor = '#f44336';
        btn.removeAttribute('data-selected');
        
        AppState.addNotification(`✅ Vallín ${vallinNum} eliminado`, 'success');
        if (navigator.vibrate) navigator.vibrate(100);
        
    } else {
        // Nuevo vallín seleccionado: primero quitar selección de otros botones del mismo grupo
        const container = btn.parentElement;
        const allButtons = container.querySelectorAll('.vallin-btn');
        allButtons.forEach(b => {
            b.style.backgroundColor = '#f44336';
            b.removeAttribute('data-selected');
        });
        
        // Marcar este botón como seleccionado
        btn.style.backgroundColor = '#4CAF50';
        btn.setAttribute('data-selected', 'true');
        
        // Guardar en Firebase
        await peleaRef.child('vallin').set(vallinNum);
        
        // Actualizar estado local
        if (calificacionesCargadas.has(peleaIndex)) {
            const cal = calificacionesCargadas.get(peleaIndex);
            cal.vallin = vallinNum;
            calificacionesCargadas.set(peleaIndex, cal);
        } else {
            calificacionesCargadas.set(peleaIndex, { vallin: vallinNum });
        }
        
        AppState.addNotification(`✅ Vallín ${vallinNum} seleccionado`, 'success');
        if (navigator.vibrate) navigator.vibrate(100);
    }
    
