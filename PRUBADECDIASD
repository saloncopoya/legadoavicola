    const uploadImage = async (file) => {
        return new Promise(async (resolve, reject) => {
            if (!file) return reject('No hay archivo');
            if (!file.type.startsWith('image/')) return reject('Solo imágenes');
            if (file.size > 10 * 1024 * 1024) return reject('Máximo 10MB');
            
            try {
                const compressedFile = await compressImage(file);
                const formData = new FormData();
                formData.append('file', compressedFile);
                formData.append('upload_preset', CLOUDINARY.uploadPreset);
                
                const xhr = new XMLHttpRequest();
                xhr.open('POST', `https://api.cloudinary.com/v1_1/${CLOUDINARY.cloudName}/image/upload`);
                xhr.onload = () => {
                    if (xhr.status === 200) {
                        const res = JSON.parse(xhr.responseText);
                        resolve(res.secure_url);
                    } else {
                        reject(`Error ${xhr.status}`);
                    }
                };
                xhr.onerror = () => reject('Error de red');
                xhr.send(formData);
            } catch(e) {
                reject('Error al comprimir imagen');
            }
        });
    };
    
