    if (headerOriginal) {
        // Buscar la sección de peleas rápidas (está dentro del header)
        let peleasRapidas = null;
        for (const child of headerOriginal.children) {
            if (child.innerHTML.includes('MÁS RÁPIDAS') || 
                child.innerHTML.includes('más rápidas') ||
