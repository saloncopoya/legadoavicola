async function handleGoogleCredentialResponse(response) {


 // 🟣 LOG PARA RESPUESTA DE GOOGLE
  console.log("🟣 Usuario seleciona cuenta GOOGLE RESPONDIÓ desde:", {
    funcion: "handleGoogleCredentialResponse",
    email: response.email || "no disponible",
    timestamp: new Date().toISOString()
  });


  showLoadingScreen('Autenticando...', 50);

  try {
    // --- (Tu código existente para inicializar Firebase si es necesario) ---
    if (!AppState.firebase.isEnabled || !AppState.firebase.app) {
      console.log("🔥 Inicializando Firebase AHORA (usuario ya eligió cuenta)");
      if (typeof firebase !== 'undefined' && firebaseConfig) {
        const firebaseApp = firebase.initializeApp(firebaseConfig);
        AppState.firebase.app = firebaseApp;
        AppState.firebase.auth = firebase.auth();
        AppState.firebase.isEnabled = true;
        await new Promise(resolve => setTimeout(resolve, 500));
      } else {
        throw new Error("Firebase SDK no disponible");
      }
    }
    // --- Fin de la inicialización ---

    const credential = firebase.auth.GoogleAuthProvider.credential(response.credential);
    const result = await AppState.firebase.auth.signInWithCredential(credential);

    if (!AppState.firebase.database) {
      console.log("📦 Inicializando database para Google user...");
      AppState.firebase.database = firebase.database();
    }

    updateLoadingProgress(80, 'Verificando usuario...');

    const user = result.user;
    const currentUser = firebase.auth().currentUser;
    if (!currentUser) {
        throw new Error('Usuario no autenticado');
    }

    const snapshot = await AppState.firebase.database.ref('users/' + currentUser.uid).once('value');

    // --- LÓGICA CORREGIDA A PARTIR DE AQUÍ ---
if (!snapshot.exists()) {
    console.log("📝 Registrando nuevo usuario de Google");
    
    // 🔥 NUEVO: Leer permisos desde Firebase
    let defaultPermissions = {
      activated: false,
      gallo: false,
      isJudge: false,
      publicaciones: false,
      pedigri: false,
      ventas: false
    };
    
    try {
      // Intentar leer desde el nodo config
      const configSnapshot = await AppState.firebase.database.ref('config/defaultPermissions').once('value');
      if (configSnapshot.exists()) {
