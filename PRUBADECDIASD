    const vallinNum = parseInt(btn.getAttribute('data-vallin'), 10);
    const isSelected = btn.getAttribute('data-selected') === 'true';
    
    // Referencia a la pelea en Firebase
    if (!adminDb || !torneoActual || !torneoActual.cotejoId) {
