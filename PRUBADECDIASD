        // Buscar la sección de peleas rápidas (está dentro del header)
        let peleasRapidas = null;
        for (const child of headerOriginal.children) {
            if (child.innerHTML.includes('MÁS RÁPIDAS') || 
                child.innerHTML.includes('más rápidas') ||
                (child.querySelector && child.querySelector('[class*="rapida"]'))) {
                peleasRapidas = child.cloneNode(true);
                break;
            }
        }
        
        // Crear nuevo header con logo integrado
        const nuevoHeader = document.createElement('div');
        nuevoHeader.style.cssText = headerOriginal.style.cssText;
