    }
  }
  
  try {
    console.log('🔐 Verificando dispositivo para:', user.uid);
    
    const database = AppState.firebase.database;
    
    // 1. Obtener huella ACTUAL
    const currentDevice = await getDeviceFingerprint();
    
    // 2. Obtener perfil del usuario
    const userSnapshot = await database.ref('users/' + user.uid).once('value');
   
if (!userSnapshot.exists()) {
  console.log("📝 Usuario nuevo - perfil aún no creado, permitiendo registro");
  return true;  // ← SOLO CAMBIA false POR true
}

    
    const userProfile = userSnapshot.val();
