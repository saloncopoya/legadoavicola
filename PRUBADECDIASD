            if (gallo.peso > 0) {
                if (gallo.peso < configuracion.pesoMin || gallo.peso > configuracion.pesoMax) {
                    AppState.addNotification(`❌ El peso del gallo ${gallo.anillo} debe estar entre ${configuracion.pesoMin} y ${configuracion.pesoMax} gramos`, 'error');
