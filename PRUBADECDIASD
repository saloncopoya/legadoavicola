  if (!currentUser || !database) { 
    AppState.addNotification('No hay usuario logueado', 'error');
    return; 
  }
  
  try {
    const snapshot = await database.ref('users/' + currentUser.uid + '/activated').once('value');
    
    if (snapshot.val() === true) {
