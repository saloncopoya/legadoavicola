    // --- Función global para seleccionar/deseleccionar ---
    window.seleccionarJuez = (element) => {
        const checkbox = element.querySelector('.juez-checkbox');
        checkbox.checked = !checkbox.checked;
        
        const uid = element.dataset.uid;
        const juez = listaCompletaJueces.find(j => j.uid === uid);
        if (juez) {
            juez.seleccionado = checkbox.checked;
        }
        
        // Actualizar UI
        element.style.backgroundColor = checkbox.checked ? '#e8f5e8' : 'transparent';
