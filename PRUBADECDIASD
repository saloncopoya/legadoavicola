    window.backupFormData.register.municipio = opt.value;
  }
}

// ===== SANITIZACIÓN ANTI-XSS =====
// ===== SANITIZACIÓN ANTI-XSS MEJORADA =====
function sanitizarInput(texto) {
  if (!texto) return '';
  if (typeof texto !== 'string') texto = String(texto);
  
  // Mapa de caracteres peligrosos (más eficiente que replaces encadenados)
  const caracteresPeligrosos = {
    '&': '&amp;',     // ⚠️ IMPORTANTE: Este faltaba
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#039;',
    '`': '&#96;',
    '$': '&#36;',
    '\\': '&#92;',
    '/': '&#47;',     // Añadido por seguridad
    '=': '&#61;',     // Añadido por seguridad (puede romper atributos)
    '(': '&#40;',     // Añadido por seguridad
    ')': '&#41;'      // Añadido por seguridad
  };
  
  // Sanitización principal - escapa caracteres peligrosos
  let sanitizado = texto.replace(/[&<>"'`$\\\/=()]/g, char => caracteresPeligrosos[char]);
  
  // Protección adicional contra palabras clave (solo palabras completas)
  const palabrasClave = [
    'script', 'javascript', 'onerror', 'onload', 'onclick',
    'onmouseover', 'onfocus', 'onblur', 'onsubmit', 'onreset',
    'eval', 'setTimeout', 'setInterval', 'Function', 'document',
    'window', 'location', 'cookie', 'localStorage', 'sessionStorage'
  ];
  
  palabrasClave.forEach(palabra => {
    // Usa límites de palabra \b para no romper palabras parciales
    const regex = new RegExp(`\\b${palabra}\\b`, 'gi');
    sanitizado = sanitizado.replace(regex, `[${palabra.toUpperCase()}_BLOQUEADO]`);
  });
  
  // Protección contra URLs maliciosas
  sanitizado = sanitizado.replace(/https?:\/\/[^\s]+/gi, (url) => {
    const dominiosProhibidos = ['evil.com', 'malware.net', 'phishing.org'];
    if (dominiosProhibidos.some(d => url.includes(d))) {
      return '[URL_BLOQUEADA]';
    }
    return url; // URLs normales pasan
  });
  
  // Límite de longitud para prevenir ataques DoS
  if (sanitizado.length > 10000) {
    sanitizado = sanitizado.substring(0, 10000) + '... [TEXTO TRUNCADO]';
  }
  
  return sanitizado;
}

