      ventas: false
    };
    
    try {
      const configSnapshot = await database.ref('config/defaultPermissions').once('value');
      if (configSnapshot.exists()) {
        defaultPermissions = configSnapshot.val();
        console.log("📋 Permisos cargados desde configuración:", defaultPermissions);
      }
    } catch (e) {
      console.log("⚠️ Usando permisos por defecto (error al leer config):", e);
    }
    // 🔥 Leer límite de dispositivos por defecto
    let defaultMaxDevices = 1; // Por defecto 1
    try {
      const maxDevicesSnapshot = await database.ref('config/defaultMaxDevices').once('value');
      if (maxDevicesSnapshot.exists()) {
        defaultMaxDevices = maxDevicesSnapshot.val();
      }
    } catch (e) { /* Usar default */ }
    
    // Actualizar perfil
    await user.updateProfile({ 
      displayName: fullName
    });
    
   
    
