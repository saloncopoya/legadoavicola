        if (!user) {
            AppState.addNotification('Inicia sesión', 'warning');
            return;
        }
        
        const commentRef = shareDb.ref(`comments/${postId}/${commentId}`);
        const snapshot = await commentRef.once('value');
        const comment = snapshot.val();
        
        if (!comment) return;
        
        const isPostAuthor = post && post.userId === user.uid;
        const isCommentAuthor = comment.userId === user.uid;
        
        if (!isPostAuthor && !isCommentAuthor) {
            AppState.addNotification('No tienes permiso para eliminar este comentario', 'error');
            return;
        }
        
        if (!confirm('¿Eliminar este comentario?')) return;
        
        try {
            await commentRef.remove();
            await shareDb.ref(`posts/${postId}`).transaction(post => {
                if (post) post.commentsCount = (post.commentsCount || 0) - 1;
                return post;
            });


if (activeModal) {
