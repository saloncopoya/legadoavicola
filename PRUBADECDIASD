                        container.innerHTML = renderTablaPosicion(torneoSeleccionado.tablaPosicion, torneoSeleccionado.config || {});
                    }
                } else if (tablaActual === 'serial') {
                    const container = document.querySelector('#cotejo-resultados-container');
                    if (container && datosSerial.length > 0) {
                        container.innerHTML = renderTablaSerial();
                    }
                } else if (tablaActual === 'registro') {
