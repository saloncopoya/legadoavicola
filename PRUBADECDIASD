                    cargarDetalleTorneo(uid, torneo);
                }
            });
        });

        // Eventos para pestañas (se manejan con onclick directo)
        
        // Scroll infinito
        const sentinel = document.getElementById('rooster-sentinel');
        if (sentinel && !torneoSeleccionado) {
            const observer = new IntersectionObserver((entries) => {
                if (entries[0].isIntersecting && hayMasPaginas && !cargandoMas) {
                    cargarMasTorneos();
                }
            }, { threshold: 0.1 });
            observer.observe(sentinel);
        }
    };

    const cargarMasTorneos = () => {
        if (cargandoMas || !hayMasPaginas) return;
        cargandoMas = true;
        paginaActual++;
        const fin = paginaActual * CONFIG.PAGE_SIZE;
        torneosVisibles = todosLosTorneos.slice(0, fin);
        hayMasPaginas = fin < todosLosTorneos.length;
        cargandoMas = false;
        renderUI();
    };

// Función para filtrar por club
const filtrarPorClub = (club) => {
    clubSeleccionado = club;
    paginaActual = 1;
    
    if (club === null) {
        torneosVisibles = todosLosTorneos.slice(0, CONFIG.PAGE_SIZE);
        hayMasPaginas = todosLosTorneos.length > CONFIG.PAGE_SIZE;
    } else {
        const filtrados = todosLosTorneos.filter(t => t.palenque === club);
        torneosVisibles = filtrados.slice(0, CONFIG.PAGE_SIZE);
        hayMasPaginas = filtrados.length > CONFIG.PAGE_SIZE;
    }
    renderUI();
};


