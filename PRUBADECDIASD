    window.eliminarAsignacionesJueces = async () => {
        if (sinInternet()) return;

        if (!confirm('⚠️ ¿Eliminar TODAS las asignaciones de jueces?')) {
            return;
        }

        const btnEliminar = document.getElementById('btn-eliminar-asignaciones');
        btnEliminar.disabled = true;
        btnEliminar.innerHTML = '⏳ ELIMINANDO...';

        try {
            const updates = {};
            for (let i = 1; i <= 5; i++) {
                updates[`juez${i}`] = null;
            }
            updates.tiempoPermisoJueces = null;

            await adminDb.ref('TORNEOS').child(uid).child(torneoId).update(updates);

            // Desmarcar todos
            listaCompletaJueces.forEach(j => j.seleccionado = false);
            
            // Actualizar vista (vacía)
            renderizarJuecesAsignados();
            
