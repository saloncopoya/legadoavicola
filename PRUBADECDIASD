const connectionBar = document.getElementById('connection-status-bar');
const connectionMessage = document.getElementById('connection-status-message');

// Función para obtener el tipo de conexión (si está disponible)
function getConnectionType() {
  if ('connection' in navigator) {
    const conn = navigator.connection || 
                 navigator.mozConnection || 
                 navigator.webkitConnection;
    
    if (conn) {
      return {
        effectiveType: conn.effectiveType, // '4g', '3g', '2g', 'slow-2g'
        downlink: conn.downlink, // Mbps
        rtt: conn.rtt, // ms
        saveData: conn.saveData // boolean
      };
    }
  }
  return null;
}

// Función para determinar si la conexión es lenta
function isSlowConnection() {
  const connInfo = getConnectionType();
  if (!connInfo) return false;
  
  // Consideramos lenta si es 2G, slow-2G, o menos de 0.5 Mbps
  return connInfo.effectiveType === '2g' || 
         connInfo.effectiveType === 'slow-2g' ||
         connInfo.downlink < 0.5;
}

