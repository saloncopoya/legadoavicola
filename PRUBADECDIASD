            btnRefresh.disabled = true;
            btnRefresh.style.opacity = '0.7';
            btnRefresh.style.cursor = 'not-allowed';
            
            try {
                // Recargar datos desde Firebase
                await cargarDetalleTorneo(uidTorneoSeleccionado, torneoSeleccionado);
                
                // Actualizar SOLO la tabla visible (sin re-renderizar toda la pantalla)
                if (tablaActual === 'cotejo') {
