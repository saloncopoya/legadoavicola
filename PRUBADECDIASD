// FUNCIÓN PARA ABRIR EN NAVEGADOR EXTERNO
// ==============================================
function abrirEnNavegadorExterno(url) {
    // Para Android
    if (/Android/i.test(navigator.userAgent)) {
        const intentUrl = `intent://${url.replace('https://', '').replace('http://', '')}#Intent;scheme=https;package=com.android.chrome;end;`;
        window.location.href = intentUrl;
       setTimeout(() => {
            if (window.AppState && AppState.addNotification) {
                AppState.addNotification(
                    '🔍 Si no se abre automáticamente:\n\n' +
            '🔍 Toca los 3 puntos ⋮\n\n' +
            '🔍 Selecciona "Abrir en navegador externo"\n\n' +
            '🔍 Esto está en la parte superior derecha',
            'warning',
                    20000
                );
            }
        }, 8000);
    } 
    // Para iOS (iPhone/iPad)
    else if (/iPhone|iPad|iPod/i.test(navigator.userAgent)) {
        alert('📱 Para ver el torneo:\n1. Toca el botón "Compartir" (cuadrito con flecha)\n2. Selecciona "Abrir en Safari"');
        window.open(url, '_blank');
    } 
    // Para PC o escritorio
    else {
        window.open(url, '_blank');
    }
}





