window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  
  // Solo guardar el prompt si NO ha cancelado en esta sesión
  if (!userCanceled) {
    deferredPrompt = e;
  }
  
  // Mostrar overlay solo si NO está instalada Y NO ha cancelado en esta sesión
  if (!(window.matchMedia('(display-mode: standalone)').matches || 
        window.navigator.standalone) && !userCanceled) {
    document.getElementById('installOverlay').style.display = 'block';
    console.log("🔘 Overlay transparente activado");
  }
});

