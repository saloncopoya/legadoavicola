// toggleUserJudge MEJORADA (MISMO PATRÓN QUE ACTIVATED)
// ==============================================
window.toggleUserJudge = async function(uid, setJudge) {
  const currentUser = AppState.user.current;
  const database = AppState.firebase.database;
  const userProfile = AppState.user.profile;
  const currentScreen = AppState.ui.currentScreen;

  // ===== NUEVA LÍNEA 1: Validar UID =====
  if (!uid || typeof uid !== 'string') {
    AppState.addNotification('❌ ID de usuario inválido', 'error');
    return;
  }

  // ===== TU VALIDACIÓN ORIGINAL (INTACTA) =====
  if (!currentUser || !database || !userProfile || userProfile.gallo !== true) {
    AppState.addNotification('No tienes permisos', 'error');
    return;
  }

  // ===== NUEVA LÍNEA 2: Feedback visual =====
  AppState.addNotification('⏳ Procesando...', 'info');

  try {
    // ===== NUEVA LÍNEA 3: VERIFICACIÓN EXTRA desde Firebase (¡LA CLAVE!) =====
    const adminSnapshot = await database
      .ref(`users/${currentUser.uid}/gallo`)
      .once('value');
    
    if (adminSnapshot.val() !== true) {
      AppState.addNotification('❌ Tus permisos han sido revocados', 'error');
      return;
    }

    // ===== NUEVA LÍNEA 4: Verificar que usuario destino existe =====
    const targetSnapshot = await database
      .ref(`users/${uid}`)
      .once('value');
    
    if (!targetSnapshot.exists()) {
      AppState.addNotification('❌ El usuario no existe', 'error');
      return;
    }

    // ===== TU ACCIÓN ORIGINAL (INTACTA) =====
    await database.ref(`users/${uid}/isJudge`).set(setJudge);
    
    // ===== TU NOTIFICACIÓN ORIGINAL (INTACTA) =====
    AppState.addNotification(
      `Usuario ${setJudge ? 'ahora es JUEZ' : 'ya no es juez'}`, 
      'success'
    );
    
    // ===== TU RECARGA ORIGINAL (INTACTA) =====
    if (currentScreen === 'admin') {
      renderApp();
    }

    // ===== NUEVA LÍNEA 5: Si se modificó a sí mismo, actualizar perfil =====
    if (uid === currentUser.uid) {
      console.log('👤 El admin se modificó a sí mismo, actualizando perfil...');
      
      // Recargar perfil para reflejar cambios inmediatos
      setTimeout(async () => {
        const freshSnapshot = await database.ref('users/' + currentUser.uid).once('value');
        if (freshSnapshot.exists()) {
          const freshProfile = { id: currentUser.uid, ...freshSnapshot.val() };
          AppState.setUser(currentUser, freshProfile);
        }
      }, 500);
    }

  } catch (error) {
    // ===== TU MANEJO DE ERRORES ORIGINAL (INTACTO) =====
    console.error('Error:', error);
    AppState.addNotification('Error al cambiar rol', 'error');
  }
};





