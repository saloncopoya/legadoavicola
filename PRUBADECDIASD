    window.generarDescargaCotejoJSON = function() {
        if (sinInternet()) return;
        
        if (!torneoActual) {
            AppState.addNotification('❌ No hay torneo activo para exportar', 'error');
            window.cerrarModalDescargaCotejo();
            return;
        }

        // 1. Recolectar TODA la información del torneo
        const datosCompletos = {
            infoTorneo: {
                id: torneoActual.id,
                nombre: torneoActual.nombre,
                fecha: torneoActual.fecha,
                organizador: torneoActual.organizador,
                lugar: torneoActual.lugar,
                palenque: torneoActual.palenque,
                createdAt: torneoActual.createdAt,
                pesoMin: torneoActual.pesoMin,
                pesoMax: torneoActual.pesoMax,
                config: torneoActual.config,
                puntosConfig: torneoActual.puntosConfig,
                serialInfo: torneoActual.serialInfo || null
            },
            registroPartidos: partidosList.map(g => ({
                anillo: g.anillo,
                peso: g.peso,
                color: g.color,
                partido: g.partido,
                representante: g.representante,
                matchId: g.matchId || null
            })),
            resultadosCotejo: resultadosCotejo ? {
                modo: cotejoUltimoModo,
                metricas: resultadosCotejo.metricas,
                peleas: resultadosCotejo.peleas.map(p => ({
                    numero: p.numero,
                    gallo1: { ...p.gallo1 },
                    gallo2: { ...p.gallo2 },
                    diferencia: p.diferencia
                })),
                noEmparejados: resultadosCotejo.noEmparejados.map(item => ({
                    ...item.gallo,
                    motivo: item.motivo
                }))
            } : null,
            calificaciones: Array.from(calificacionesCargadas.entries()).map(([index, cal]) => ({
                indicePelea: index,
                ...cal
            }))
        };

        // 2. Crear el archivo JSON
        const jsonStr = JSON.stringify(datosCompletos, null, 2);
        const blob = new Blob([jsonStr], {type: 'application/json'});
        const url = URL.createObjectURL(blob);
        
        // 3. Generar nombre de archivo
        const nombreArchivo = `${torneoActual.nombre || 'torneo'}_${torneoActual.fecha || 'fecha'}_export.json`.replace(/[^a-z0-9_\-]/gi, '_');
        
        // 4. Simular clic para descargar
        const a = document.createElement('a');
        a.href = url;
        a.download = nombreArchivo;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        
        AppState.addNotification(`✅ Datos del torneo "${torneoActual.nombre}" exportados a JSON`, 'success');
        window.cerrarModalDescargaCotejo();
    };


