    // Guardar texto original y deshabilitar
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = '⏳ DESVINCULANDO...';
    btn.style.opacity = '0.7';
    btn.style.cursor = 'not-allowed';

    try {
        if (!serialIdActual || torneosEnSerialActual.length === 0) {
            AppState.addNotification('❌ No hay un serial activo para desvincular', 'warning');
            return;
        }

        if (!confirm(`¿Desvincular el serial "${serialIdActual}" de los ${torneosEnSerialActual.length} torneos?`)) {
            return;
        }

        AppState.addNotification('🔄 Desvinculando serial...', 'info');

        const operaciones = [];
        for (const tId of torneosEnSerialActual) {
            const torneoRef = adminDb.ref('TORNEOS').child(uid).child(tId);
            operaciones.push(torneoRef.child('serialInfo').remove());
        }

        await Promise.all(operaciones);

        serialIdActual = null;
        torneosEnSerialActual = [];
        nombresPartidosUnificados = [];

        if (torneoActual) {
            if (torneoActual.serialInfo) delete torneoActual.serialInfo;
        }

        actualizarPantalla();

        const badge = document.getElementById('serial-visibility-badge');
        if (badge) badge.innerHTML = 'SIN SERIAL';

        const modal = document.getElementById('tournament-modal-overlay');
        if (modal) modal.remove();

        AppState.addNotification('✅ Serial desvinculado', 'success');
        if (navigator.vibrate) navigator.vibrate(500);

    } catch (error) {
        console.error("Error desvinculando serial:", error);
        AppState.addNotification('❌ Error al desvincular serial', 'error');
