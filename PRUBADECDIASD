function checkIfEverythingLoaded() {
  console.log("⏳ Verificando carga de componentes...");
  
  // Limpiar intervalo anterior si existe
  if (loadingInterval) {
    clearInterval(loadingInterval);
    loadingInterval = null;
    console.log("🧹 Limpiando intervalo anterior");
  }
  
  let progress = 10;
  let intentos = 0;
  
  // Calcular timeout según la señal (IGUAL QUE TU CÓDIGO)
  let timeoutMs = 20500; // Default
  if (navigator.connection?.effectiveType === '4g') timeoutMs = 10000;
  else if (navigator.connection?.effectiveType === '3g') timeoutMs = 15000;
  else if (navigator.connection?.effectiveType === '2g' || navigator.connection?.effectiveType === 'slow-2g') timeoutMs = 25000;
  
  const MAX_INTENTOS = Math.ceil(timeoutMs / 200); // Convertir ms a intentos
  
  // UN SOLO INTERVALO (hace el trabajo de 2)
  loadingInterval = setInterval(() => {
    intentos++;
    
    // 1. Actualizar barra de progreso
    if (progress < 90 && AppState.ui.isLoading) {
      progress += 5;
      updateLoadingProgress(progress, 'Cargando componentes...');
    }
    
    // 2. Verificar si ya terminó de cargar
    if (!AppState.ui.isLoading) {
      clearInterval(loadingInterval);
      loadingInterval = null;
      console.log("✅ Todo cargado - Ocultando pantalla de carga");
      
      updateLoadingProgress(100, '¡Listo!');
      
      setTimeout(() => {
        const loadingScreen = document.getElementById('loading-screen');
        const socialApp = document.getElementById('social-app');
        
        if (loadingScreen) {
          loadingScreen.style.opacity = '0';
          setTimeout(() => {
            loadingScreen.style.display = 'none';
            if (socialApp) socialApp.style.display = 'block';
          }, 500);
        }
      }, 300);
    }
    
    // 3. Timeout según la señal de conexión (IGUAL QUE TU CÓDIGO)
    if (intentos >= MAX_INTENTOS && AppState.ui.isLoading) {
      clearInterval(loadingInterval);
      loadingInterval = null;
      console.warn(`⚠️ Timeout de carga (${timeoutMs/1000} segundos) - Forzando ocultar`);
