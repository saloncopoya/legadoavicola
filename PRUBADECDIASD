                <p style="color:#65676b;">Sé el primero en compartir algo</p>
            </div>
        `;
        ultimoHTMLPosts = htmlVacio;
        container.innerHTML = htmlVacio;
        return;
    }
    
    let sorted = [...filteredPosts].sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
    let highlightedHtml = '';
    let normalHtml = '';
    
    if (highlightPost) {
        const idx = sorted.findIndex(p => p.id === highlightPost.id);
        if (idx !== -1) {
            sorted.splice(idx, 1);
            highlightedHtml = renderPostCard(highlightPost, true);
        }
    }
    
    sorted.forEach(post => { normalHtml += renderPostCard(post, false); });
    
    // 🔥 CONSTRUIR EL HTML COMPLETO
    const htmlGenerado = highlightedHtml + normalHtml;
    
    // 🔥 GUARDAR EN CACHÉ Y MOSTRAR
    ultimoHTMLPosts = htmlGenerado;
