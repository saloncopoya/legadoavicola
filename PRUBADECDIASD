            // Procesar gallo 1
            if (g1?.partido) {
                const data = initPartidoSerial(g1.partido);
                if (data) {
                    data.torneosParticipados.add(item.torneoId);
                    
                    if (ganador === 'rojo') {
                        data.puntos += puntosConfig.ganador;
                        data.tiempo += tiempoSegundos;
                        data.victorias++;
                    } else if (ganador === 'verde') {
