// ==============================================
// RATE LIMITING SIMPLE (LocalStorage)
// ==============================================
const RateLimiter = {
  // Guardar intentos
  recordAttempt(action) {
    const key = `rate_${action}`;
    const now = Date.now();
    const attempts = JSON.parse(localStorage.getItem(key) || '[]');
    
    // Limpiar intentos mayores a 15 minutos
    const recent = attempts.filter(time => now - time < 900000);
    recent.push(now);
    
    localStorage.setItem(key, JSON.stringify(recent));
    return recent.length;
  },
  
  // Verificar si puede intentar
  canAttempt(action, maxAttempts = 5, timeWindow = 900000) { // 15 minutos
    const key = `rate_${action}`;
    const now = Date.now();
    const attempts = JSON.parse(localStorage.getItem(key) || '[]');
    const recent = attempts.filter(time => now - time < timeWindow);
    
    localStorage.setItem(key, JSON.stringify(recent));
    return recent.length < maxAttempts;
  },
  
  // Obtener tiempo de espera restante
  getWaitTime(action, maxAttempts = 5) {
    const key = `rate_${action}`;
    const now = Date.now();
    const attempts = JSON.parse(localStorage.getItem(key) || '[]');
    
    if (attempts.length < maxAttempts) return 0;
    
    const oldest = Math.min(...attempts);
    const waitTime = 900000 - (now - oldest); // 15 minutos - tiempo transcurrido
    
    return waitTime > 0 ? Math.ceil(waitTime / 1000) : 0; // segundos
  }
};



// ==============================================
// FINGERPRINT INMUTABLE (NUNCA CAMBIA)
// ==============================================
window.getDeviceFingerprint = function() {
  try {
    // 1. GPU (EL MÁS IMPORTANTE)
    let gpuRenderer = 'unknown';
    try {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl');
      if (gl) {
        const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
        if (debugInfo) {
          gpuRenderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
        }
      }
    } catch(e) { /* Silencio */ }
    
    // 2. Núcleos de CPU (físicos)
    const cpuCores = navigator.hardwareConcurrency || 'unknown';
    
    // 3. Resolución FÍSICA
    const pixelRatio = window.devicePixelRatio || 1;
    const physicalWidth = Math.round(screen.width * pixelRatio);
    const physicalHeight = Math.round(screen.height * pixelRatio);
    const physicalResolution = `${physicalWidth}x${physicalHeight}`;
    
    // 4. Familia del OS
    const ua = navigator.userAgent;
    let osFamily = 'unknown';
    if (ua.includes('Android')) osFamily = 'android';
    else if (ua.includes('iPhone') || ua.includes('iPad')) osFamily = 'ios';
    else if (ua.includes('Windows')) osFamily = 'windows';
    else if (ua.includes('Mac OS')) osFamily = 'macos';
    else if (ua.includes('Linux')) osFamily = 'linux';
    
    // 5. Arquitectura
    let architecture = 'unknown';
    if (ua.includes('arm64') || ua.includes('aarch64')) architecture = 'arm64';
    else if (ua.includes('arm')) architecture = 'arm';
    else if (ua.includes('x86_64') || ua.includes('WOW64')) architecture = 'x64';
    
    // Construir componentes
    const components = {
      gpu: gpuRenderer,
      cores: cpuCores,
      resolution: physicalResolution,
      os: osFamily,
      arch: architecture,
      timestamp: Date.now()
    };
    
    // Crear string único para el hash
    const uniqueString = `${gpuRenderer}|${cpuCores}|${physicalResolution}|${osFamily}|${architecture}`;
    
    // Generar hash
    return generateHash(uniqueString).then(hash => ({
      fingerprint: hash,
      components: components,
      userAgent: ua
    }));
    
  } catch (error) {
    console.error('Error generando fingerprint:', error);
    return Promise.reject(error);
  }
};


// 🔥 VERSIÓN OPTIMIZADA - SOLO SE EJECUTA UNA VEZ
let cachedFingerprintPromise = null;

function generateHash(str) {
  // Si ya tenemos una promesa en curso, la devolvemos (solo se ejecuta una vez)
  if (cachedFingerprintPromise) {
    console.log('⚡ Usando hash en caché');
    return cachedFingerprintPromise;
  }

  console.log('🔐 Generando hash por primera y única vez...');
  
  if (window.crypto && window.crypto.subtle) {
    // Guardamos la promesa en caché para que no se repita
    cachedFingerprintPromise = crypto.subtle.digest('SHA-256', new TextEncoder().encode(str))
      .then(hash => {
        return Array.from(new Uint8Array(hash))
          .map(b => b.toString(16).padStart(2, '0'))
          .join('');
      });
    
    return cachedFingerprintPromise;
  } else {
    // Fallback rápido (también lo guardamos en caché)
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
      const char = str.charCodeAt(i);
      hash = ((hash << 5) - hash) + char;
      hash = hash & hash;
    }
    cachedFingerprintPromise = Promise.resolve(hash.toString(36));
    return cachedFingerprintPromise;
  }
}


