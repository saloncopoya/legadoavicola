    // GUARDAR EDICIÓN DE PARTIDO COMPLETO (CON VALIDACIONES)
    // ========================================================================
    const guardarEdicionPartido = async (nombreOriginal, nuevoNombre, nuevoRepresentante, gallosEditados) => {
    if (sinInternet()) return false; // ← PEGA ESTO


        if (!adminDb || !torneoId) return;

        // Validar nombre del partido
        if (!nuevoNombre || nuevoNombre.trim() === '') {
            AppState.addNotification('❌ El nombre del partido es obligatorio', 'error');
            return;
        }

        // Validar que los anillos no estén vacíos y tengan formato correcto
        for (let gallo of gallosEditados) {
            if (!gallo.anillo || gallo.anillo.trim() === '') {
                AppState.addNotification('❌ Todos los anillos son obligatorios', 'error');
                return;
            }
            
            if (!/^\d{3,4}$/.test(gallo.anillo)) {
                AppState.addNotification(`❌ El anillo ${gallo.anillo} debe tener 3 o 4 dígitos`, 'error');
                return;
            }
        }

        // Validar que no haya anillos duplicados DENTRO del mismo partido
        const anillosEnPartido = gallosEditados.map(g => g.anillo.padStart(3, '0'));
        const anillosUnicos = new Set(anillosEnPartido);
        if (anillosUnicos.size !== anillosEnPartido.length) {
            AppState.addNotification('❌ No puede haber anillos duplicados en el mismo partido', 'error');
            return;
        }

        // Validar que los anillos no estén repetidos en OTROS partidos
        for (let gallo of gallosEditados) {
            const anilloFormateado = gallo.anillo.padStart(3, '0');
            
            // Buscar si el anillo existe en otros partidos (que no sean el actual)
            const anilloExistente = partidosList.find(p => 
                p.anillo === anilloFormateado && 
                p.partido !== nombreOriginal
            );
            
            if (anilloExistente) {
                AppState.addNotification(`❌ El anillo ${gallo.anillo} ya está registrado en el partido "${anilloExistente.partido}"`, 'error');
                return;
            }
        }

        // Validar pesos
        for (let gallo of gallosEditados) {
            if (gallo.peso > 0) {
                if (gallo.peso < configuracion.pesoMin || gallo.peso > configuracion.pesoMax) {
                    AppState.addNotification(`❌ El peso del gallo ${gallo.anillo} debe estar entre ${configuracion.pesoMin} y ${configuracion.pesoMax} gramos`, 'error');
                    return;
                }
            }
        }

        try {
            // Buscar el matchId del partido original
            const partidosSnap = await adminDb.ref('TORNEOS')
                .child(uid)
                .child(torneoId)
                .child('REGISTRO')
                .once('value');

            let matchId = null;
            if (partidosSnap.exists()) {
                const pData = partidosSnap.val();
                for (let id in pData) {
                    if (pData[id].nombre === nombreOriginal) {
                        matchId = id;
                        break;
                    }
                }
            }

            if (!matchId) {
                AppState.addNotification('❌ No se encontró el partido', 'error');
                return;
            }

            // Construir objeto de gallos actualizado
            const gallosObj = {};
            gallosEditados.forEach(g => {
                gallosObj[g.anillo.padStart(3, '0')] = {
                    peso: g.peso,
                    color: g.color || ''
                };
            });

            // Actualizar en Firebase
            await adminDb.ref('TORNEOS')
                .child(uid)
                .child(torneoId)
                .child('REGISTRO')
                .child(matchId)
                .update({
                    nombre: nuevoNombre,
                    representante: nuevoRepresentante || '',
                    gallos: gallosObj
                });

            // Guardar nombre de partido si es nuevo
            if (nuevoNombre !== nombreOriginal && !nombresPartidosList.includes(nuevoNombre)) {
                const nomRef = adminDb.ref('NOMPARTIDOS').push();
                await nomRef.set({ nombre: nuevoNombre });
                nombresPartidosList.push(nuevoNombre);
            }

            // Guardar representante si es nuevo
            if (nuevoRepresentante && nuevoRepresentante.trim() !== '' && !representantesList.includes(nuevoRepresentante)) {
                representantesList.push(nuevoRepresentante);
                const repRef = adminDb.ref('TORNEOS')
                    .child(uid)
