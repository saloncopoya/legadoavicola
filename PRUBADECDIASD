                ${(() => {
                    if (!torneo.cotejo?.peleas) return '';
                    
                    const peleasCalificadas = torneo.cotejo.peleas.filter(p => p.calificada === true);
                    if (peleasCalificadas.length === 0) return '';
                    
                    const rapida = (tiempo) => {
                        if (!tiempo || tiempo === '--:--') return 9999;
                        const partes = tiempo.split(':');
                        return (parseInt(partes[0]) * 60) + (parseInt(partes[1]) || 0);
                    };
                    
                    const lista = peleasCalificadas.map(p => {
                        let ganador = '';
                        if (p.ganador === 'rojo') ganador = p.gallo1?.partido;
                        else if (p.ganador === 'verde') ganador = p.gallo2?.partido;
                        else if (p.ganador === 'empate') ganador = 'EMPATE';
                        return { nombre: ganador, tiempo: p.tiempo, segundos: rapida(p.tiempo), numero: p.numero };
                    }).filter(p => p.nombre && p.nombre !== 'EMPATE' && p.segundos > 0)
                      .sort((a, b) => a.segundos - b.segundos)
                      .slice(0, 4);
                    
                    if (lista.length === 0) return '';
                    
                    // Dividir en 2 columnas
                    const mitad = Math.ceil(lista.length / 2);
                    const columna1 = lista.slice(0, mitad);
                    const columna2 = lista.slice(mitad);
                    
                    return `
                        <div style="padding: 1px 0; background: transparent; border-radius: 8px;">
                            <div style="display: flex; align-items: center; gap: 2px; margin-bottom: 1px;">
                                <span style="font-size: clamp(11px, 3vw, 13px);">⚡</span>
