// SOLUCIÓN ANDROID SIN BLOBS - SIN VARIABLES DUPLICADAS
if ('serviceWorker' in navigator && location.protocol === 'https:') {
  
  const initAndroidPWA = () => {
    console.log('🚀 Iniciando PWA para Android...');
    
    // INTENTO 1: Service Worker usando eval() para evitar blob:
    try {
      // Creamos un SW dinámico
      const swScript = `
        // Service Worker para Android PWA
        self.addEventListener('install', function(e) {
          console.log('[ANDROID-PWA] Service Worker instalado');
          self.skipWaiting();
        });
        
        self.addEventListener('activate', function(e) {
          console.log('[ANDROID-PWA] Service Worker activado - APP NATIVA');
          e.waitUntil(clients.claim());
        });
        
        // Fetch básico para cumplir requisitos PWA
        self.addEventListener('fetch', function(e) {
          // Solo manejamos requests de nuestro dominio
          if (e.request.url.startsWith('${location.origin}')) {
            e.respondWith(
              fetch(e.request).catch(function() {
                // Fallback para offline
                return new Response('<h1>App Gallos - Modo Offline</h1>', {
                  headers: {'Content-Type': 'text/html'}
                });
              })
            );
          }
        });
      `;
      
      // Convertir a data URL base64 (Android lo acepta)
      const swBase64 = btoa(swScript);
      const swDataURL = 'data:application/javascript;base64,' + swBase64;
      
      navigator.serviceWorker.register(swDataURL, {
        scope: './',
        updateViaCache: 'none'
      })
      .then(function(registration) {
        console.log('✅ Service Worker Android registrado:', registration.scope);
        
        // Forzar activación inmediata
        if (registration.waiting) {
          registration.waiting.postMessage('skipWaiting');
        }
        if (registration.installing) {
          registration.installing.postMessage('skipWaiting');
        }
        
        // Activar el prompt de instalación
        setTimeout(() => {
          if (window.AndroidInstallPrompt !== undefined) {
            window.dispatchEvent(new Event('android-pwa-ready'));
          }
        }, 2000);
        
        return registration.update();
      })
      .catch(function(error) {
        console.log('⚠️ SW Data URL falló, intentando alternativa...');
        // Intentamos método alternativo sin SW
        attemptPWANoSW();
      });
      
    } catch (e) {
      console.log('ℹ️ Método principal falló, usando alternativa');
      attemptPWANoSW();
    }
  };
  
  // Método alternativo para PWA básica
