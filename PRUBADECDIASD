// Función para formatear anillo a 3 dígitos (ej: 1 → 001, 12 → 012, 432 → 432)
window.formatearAnillo = (input) => {
    if (!input) return;
    let valor = input.value.trim();
    if (valor === '') return;
    let numero = parseInt(valor, 10);
    if (isNaN(numero)) {
        input.value = '';
        return;
    }
    // Formatear a 3 dígitos con ceros a la izquierda
    input.value = numero.toString().padStart(3, '0');
};

// Función principal para registrar una pelea manualmente

window.registrarPeleaManual = async () => {
    if (sinInternet()) return;

// Verificar permiso cotejo
const userProfile = AppState?.user?.profile;
if (!userProfile || userProfile.cotejo !== true) {
    AppState.addNotification('⛔ No tienes permiso para registrar peleas. Contrata el servicio.', 'error', 4000);
    if (navigator.vibrate) navigator.vibrate([300, 200, 300]);
    return;
}

    // Obtener valores del formulario
    const rojoPartido = document.getElementById('pelea-rojo-partido')?.value.trim().toUpperCase() || '';
    const rojoAnilloRaw = document.getElementById('pelea-rojo-anillo')?.value.trim() || '';
    const rojoPesoRaw = document.getElementById('pelea-rojo-peso')?.value.trim() || '';
    
    const verdePartido = document.getElementById('pelea-verde-partido')?.value.trim().toUpperCase() || '';
    const verdeAnilloRaw = document.getElementById('pelea-verde-anillo')?.value.trim() || '';
    const verdePesoRaw = document.getElementById('pelea-verde-peso')?.value.trim() || '';

    // Formatear anillos a 3 dígitos
    const rojoAnilloNum = parseInt(rojoAnilloRaw, 10);
    const verdeAnilloNum = parseInt(verdeAnilloRaw, 10);
    const rojoAnillo = isNaN(rojoAnilloNum) ? '' : rojoAnilloNum.toString().padStart(3, '0');
    const verdeAnillo = isNaN(verdeAnilloNum) ? '' : verdeAnilloNum.toString().padStart(3, '0');

    // ===== VALIDACIONES =====
    if (!rojoPartido) {
        AppState.addNotification('❌ Partido de CINTA ROJA es obligatorio', 'error');
        document.getElementById('pelea-rojo-partido').focus();
        return;
    }
    if (!verdePartido) {
        AppState.addNotification('❌ Partido de CINTA VERDE es obligatorio', 'error');
        document.getElementById('pelea-verde-partido').focus();
        return;
    }
    if (rojoPartido === verdePartido) {
        AppState.addNotification('❌ Los partidos no pueden ser iguales', 'error');
        return;
    }
    if (!rojoAnillo) {
        AppState.addNotification('❌ Anillo de CINTA ROJA es obligatorio', 'error');
        document.getElementById('pelea-rojo-anillo').focus();
        return;
    }
    if (!verdeAnillo) {
        AppState.addNotification('❌ Anillo de CINTA VERDE es obligatorio', 'error');
        document.getElementById('pelea-verde-anillo').focus();
        return;
    }
    if (rojoAnillo === verdeAnillo) {
        AppState.addNotification('❌ Los anillos no pueden ser iguales', 'error');
        return;
    }

    // Verificar que los anillos no estén duplicados en la lista LOCAL
    const anillosExistentes = new Set(partidosList.map(g => g.anillo));
    if (anillosExistentes.has(rojoAnillo)) {
        const partidoExistente = partidosList.find(g => g.anillo === rojoAnillo);
        AppState.addNotification(`❌ Anillo ${rojoAnillo} ya pertenece al partido "${partidoExistente?.partido}"`, 'error');
        document.getElementById('pelea-rojo-anillo').focus();
        return;
    }
    if (anillosExistentes.has(verdeAnillo)) {
        const partidoExistente = partidosList.find(g => g.anillo === verdeAnillo);
        AppState.addNotification(`❌ Anillo ${verdeAnillo} ya pertenece al partido "${partidoExistente?.partido}"`, 'error');
        document.getElementById('pelea-verde-anillo').focus();
        return;
    }

    // Procesar pesos (opcionales)
    const rojoPeso = rojoPesoRaw ? parseInt(rojoPesoRaw, 10) : 0;
    const verdePeso = verdePesoRaw ? parseInt(verdePesoRaw, 10) : 0;

    // Bloquear botón
    const btnRegistrar = document.getElementById('btn-registrar-pelea-manual');
    const textoOriginal = btnRegistrar.textContent;
    btnRegistrar.disabled = true;
    btnRegistrar.textContent = '⏳ REGISTRANDO...';
    btnRegistrar.style.opacity = '0.7';

    try {
        // ===== SOLO GUARDAR EN MEMORIA LOCAL (NO EN FIREBASE) =====
        
        // 1. Agregar gallo ROJO a la lista LOCAL (partidosList)
        partidosList.push({
            anillo: rojoAnillo,
            peso: rojoPeso,
            color: '',
            partido: rojoPartido,
            representante: ''
        });
        
        // 2. Agregar gallo VERDE a la lista LOCAL
        partidosList.push({
            anillo: verdeAnillo,
            peso: verdePeso,
            color: '',
            partido: verdePartido,
            representante: ''
        });
        
        // 3. Agregar nombres de partidos a la lista LOCAL (si no existen)
        if (!nombresPartidosList.includes(rojoPartido)) {
            nombresPartidosList.push(rojoPartido);
        }
        if (!nombresPartidosList.includes(verdePartido)) {
            nombresPartidosList.push(verdePartido);
        }
        
        // 4. Actualizar último anillo
        const maxAnillo = Math.max(parseInt(rojoAnillo, 10), parseInt(verdeAnillo, 10), ultimoAnillo);
        ultimoAnillo = maxAnillo;
        
        // 5. Agregar la pelea al cotejo (resultadosCotejo)
        const nuevaPelea = {
            numero: resultadosCotejo.peleas.length + 1,
            gallo1: {
                anillo: rojoAnillo,
                peso: rojoPeso,
                partido: rojoPartido,
                representante: '',
                color: ''
            },
            gallo2: {
                anillo: verdeAnillo,
                peso: verdePeso,
                partido: verdePartido,
                representante: '',
                color: ''
            },
            diferencia: Math.abs(rojoPeso - verdePeso)
        };
        
        resultadosCotejo.peleas.push(nuevaPelea);
        
        // Actualizar métricas
        if (resultadosCotejo.peleas.length > 0) {
            const sumaDiferencias = resultadosCotejo.peleas.reduce((sum, p) => sum + p.diferencia, 0);
            resultadosCotejo.metricas = {
                totalGallos: partidosList.length,
                peleasGeneradas: resultadosCotejo.peleas.length,
                noEmparejados: 0,
                diferenciaPromedio: sumaDiferencias / resultadosCotejo.peleas.length,
                conflictosConsecutivos: 0
            };
        }
        
        // 6. LIMPIAR EL FORMULARIO
        document.getElementById('pelea-rojo-partido').value = '';
        document.getElementById('pelea-rojo-anillo').value = '';
        document.getElementById('pelea-rojo-peso').value = '';
        document.getElementById('pelea-verde-partido').value = '';
        document.getElementById('pelea-verde-anillo').value = '';
        document.getElementById('pelea-verde-peso').value = '';
        
       
        
        // 7. ACTUALIZAR LA INTERFAZ
        // Actualizar contador de peleas
        const contadorSpan = document.getElementById('peleas-count');
        if (contadorSpan) contadorSpan.textContent = resultadosCotejo.peleas.length;
        
        // Actualizar tabla de registro de gallos
        actualizarPantallaLigera();
        
        // Actualizar tabla de peleas registradas
        renderizarResultadosCotejo();
        
 actualizarPantalla();


        // Notificar éxito
        AppState.addNotification(`✅ Pelea registrada: ${rojoPartido} vs ${verdePartido}`, 'success');
        
        // Vibrar
        if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
        

// 8. ENFOCAR EL CAMPO "PARTIDO ROJO"
const inputRojo = document.getElementById('pelea-rojo-partido');
inputRojo.focus();
inputRojo.select();

    } catch (error) {
        console.error('❌ Error registrando pelea:', error);
        AppState.addNotification('❌ Error al registrar la pelea', 'error');
    } finally {
        // Restaurar botón
        btnRegistrar.disabled = false;
        btnRegistrar.textContent = textoOriginal;
        btnRegistrar.style.opacity = '1';
    }
};

// Función para limpiar TODAS las peleas registradas (sin eliminar gallos)
window.limpiarTodasLasPeleas = () => {
    if (sinInternet()) return;
    
    // ===== PREGUNTAR CONFIRMACIÓN =====
    const totalPeleas = resultadosCotejo?.peleas?.length || 0;
    const totalGallos = partidosList?.length || 0;
    
    if (totalPeleas === 0 && totalGallos === 0) {
        AppState.addNotification('📭 No hay peleas ni gallos para limpiar', 'info');
        return;
    }
    
    const confirmacion = confirm(
        `⚠️ ¿ELIMINAR TODAS LAS PELEAS Y GALLOS?\n\n` +
        `Se eliminarán:\n` +
        `• ${totalPeleas} pelea(s) registrada(s)\n` +
        `• ${totalGallos} gallo(s) de la tabla de registro\n\n` +
        `¡ESTA ACCIÓN NO SE PUEDE DESHACER!`
    );
    
    if (!confirmacion) {
        AppState.addNotification('❌ Limpieza cancelada', 'info');
        return;
    }
    
    // Bloquear botón
    const btnLimpiar = document.getElementById('btn-limpiar-peleas');
    if (btnLimpiar) {
        btnLimpiar.disabled = true;
        btnLimpiar.textContent = '⏳ LIMPIANDO...';
        btnLimpiar.style.opacity = '0.7';
    }
    
    try {
        // ===== 1. LIMPIAR PELEAS DEL COTEJO =====
        resultadosCotejo = {
            peleas: [],
            noEmparejados: [],
            metricas: {
                totalGallos: 0,
                peleasGeneradas: 0,
                noEmparejados: 0,
                diferenciaPromedio: 0,
                conflictosConsecutivos: 0
            }
        };
        
        // ===== 2. LIMPIAR TABLA DE REGISTRO DE GALLOS =====
        partidosList = [];
        ultimoAnillo = 0;
        representantesList = [];
        
        // ===== 3. ACTUALIZAR CONTADORES EN LA UI =====
        const contadorPeleas = document.getElementById('peleas-count');
        if (contadorPeleas) contadorPeleas.textContent = '0';
        
        const headerGallos = document.querySelector('#admin-main-container .header-estadisticas-gallos');
        if (headerGallos) headerGallos.textContent = '0';
        
        const headerPartidos = document.querySelector('#admin-main-container .header-estadisticas-partidos');
        if (headerPartidos) headerPartidos.textContent = '0';
        
        // ===== 4. ACTUALIZAR TABLAS EN PANTALLA =====
        actualizarPantallaLigera();
        renderizarResultadosCotejo();
        
        // ===== 5. FORZAR ACTUALIZACIÓN COMPLETA =====
        actualizarPantalla();
        
        AppState.addNotification(`✅ Limpiado: ${totalPeleas} peleas y ${totalGallos} gallos eliminados`, 'success');
        
        if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
        
    } catch (error) {
        console.error('❌ Error limpiando:', error);
        AppState.addNotification('❌ Error al limpiar', 'error');
    } finally {
        // Restaurar botón
        if (btnLimpiar) {
            btnLimpiar.disabled = false;
            btnLimpiar.textContent = '🗑️ LIMPIAR TODAS LAS PELEAS';
            btnLimpiar.style.opacity = '1';
        }
    }
};

