        // Buscar el botón de refresh (si existe en la página)
        const btnRefresh = document.querySelector('#btn-refresh-torneo');
        
        // Guardar qué pestaña estamos viendo ANTES de actualizar
        const tablaActual = pestanaActiva;
        
        // Nombres para mostrar en notificación
        const nombreTabla = {
            'cotejo': 'COTEJO',
            'posicion': 'POSICIONES',
            'serial': 'SERIAL',
            'registro': 'REGISTRO'
        };
        
        // Si existe el botón, mostrar estado de carga
        if (btnRefresh) {
            // Verificar si ya está deshabilitado (evitar doble clic)
            if (btnRefresh.disabled) return;
            
            const textoOriginal = btnRefresh.innerHTML;
            btnRefresh.innerHTML = '<span style="font-size:18px;">⏳</span> ACTUALIZANDO...';
            btnRefresh.disabled = true;
            btnRefresh.style.opacity = '0.7';
            btnRefresh.style.cursor = 'not-allowed';
            
            try {
                // Recargar datos desde Firebase
                await cargarDetalleTorneo(uidTorneoSeleccionado, torneoSeleccionado);
                
                // Actualizar SOLO la tabla visible (sin re-renderizar toda la pantalla)
                if (tablaActual === 'cotejo') {
                    const container = document.querySelector('#cotejo-resultados-container');
                    if (container && torneoSeleccionado.cotejo) {
                        container.innerHTML = renderTablaCotejo(torneoSeleccionado.cotejo, torneoSeleccionado.config || {});
                    }
                } else if (tablaActual === 'posicion') {
