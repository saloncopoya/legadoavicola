    AppState.rooster.cotejoState = false;
    AppState.rooster.roosters = [];
    AppState.rooster.tournamentInfo = null;

    }
    
    // ===== GUARDAR CONTEXTO ANTES DE CERRAR SESIÓN =====
    const currentScreen = AppState.ui.currentScreen;
    const estabaEnActivationPending = (currentScreen === 'activation_pending');
    
    console.log("📍 Contexto de cierre de sesión:", {
      pantalla: currentScreen,
      estabaEnActivationPending: estabaEnActivationPending
    });

    // ===== CERRAR SESIÓN EN FIREBASE (USANDO REFERENCIA DIRECTA) =====
    if (window.firebase && window.firebase.auth) {
      try {
        console.log("🔐 Cerrando sesión en Firebase con window.firebase.auth...");
        await window.firebase.auth().signOut();
        console.log("✅ Sesión de Firebase cerrada");
      } catch (e) {
        console.log("⚠️ Error al cerrar sesión con window.firebase.auth:", e);
      }
    } else {
      console.log("⚠️ window.firebase.auth no disponible");
    }
    
    // Limpiar usuario de AppState
    AppState.clearUser();
    
  // --- NUEVO: Limpiar la marca de recurrente ---

    localStorage.removeItem('lastScreen');
    localStorage.removeItem('lastUser');
sessionStorage.removeItem('lastUser');
sessionStorage.removeItem('lastScreen');
sessionStorage.removeItem('pendingLogin');
sessionStorage.removeItem('postActivationIntent');
sessionStorage.removeItem('vinoDeActivationPending');


    
    // ===== NUEVO: LIMPIAR SESSIONSTORAGE COMPLETO =====
    console.log("🧹 Limpiando sessionStorage COMPLETO...");
    sessionStorage.clear();
    console.log("✅ sessionStorage vacío");
    
    // ===== NUEVO: LIMPIAR LOCALSTORAGE DE FIREBASE =====
    console.log("🧹 Limpiando localStorage de Firebase...");
    const keysToRemove = [];
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && (key.startsWith('firebase:') || key.startsWith('app_'))) {
        keysToRemove.push(key);
      }
    }
    keysToRemove.forEach(key => localStorage.removeItem(key));
    localStorage.removeItem('firebase:previous_websocket_failure');
    console.log(`✅ Eliminadas ${keysToRemove.length} claves de localStorage`);
    
    // ===== NUEVO: LIMPIAR ScreenLoader.loadedFunctions =====
    if (window.ScreenLoader && window.ScreenLoader.loadedFunctions) {
      console.log("🧹 Limpiando ScreenLoader.loadedFunctions...");
      window.ScreenLoader.loadedFunctions = {};
      if (window.ScreenLoader.loadedScreens) {
        window.ScreenLoader.loadedScreens.clear();
      }
    }


    // ===== LÓGICA INTELIGENTE: DIFERENCIAR EL ORIGEN =====
