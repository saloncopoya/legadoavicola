    window.crearTorneo = async () => {
    // Obtener una referencia al botón
    const submitBtn = document.getElementById('submit-tournament-btn');
    if (sinInternet()) return;


const esEdicion = torneoActual && submitBtn && submitBtn.textContent.includes('ACTUALIZAR');

 

    //  Guardar el texto original y deshabilitar el botón
    const originalText = submitBtn ? submitBtn.textContent : '';
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '⏳ PROCESANDO...';
        submitBtn.style.opacity = '0.7';
        submitBtn.style.cursor = 'not-allowed';
    }

    const nombre = document.getElementById('tournament-name')?.value;
    const fecha = document.getElementById('tournament-date')?.value;
    const organizador = document.getElementById('tournament-organizer')?.value;
    const lugar = document.getElementById('tournament-place')?.value;
    const palenque = document.getElementById('tournament-palenque')?.value;
    const pesoMin = parseInt(document.getElementById('tournament-peso-min')?.value, 10) || 1700;
    const pesoMax = parseInt(document.getElementById('tournament-peso-max')?.value, 10) || 2400;
    const anillosEditables = document.getElementById('tournament-anillos-editables')?.checked || false;

    // 4.3 Validación estricta
    if (!nombre || !fecha || !organizador || !lugar || !palenque) {
        if (window.AppState && AppState.addNotification) {
            AppState.addNotification('❌ Todos los campos son obligatorios', 'error');
        }
        if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
        // 🔥 NUEVO: Re-habilitar el botón si hay error de validación
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
        }
        return;
    }

    if (nombre.length > 30) {
        if (window.AppState && AppState.addNotification) {
            AppState.addNotification('❌ Nombre del torneo muy largo (máx 30 caracteres)', 'error');
        }
        if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
        // 🔥 NUEVO: Re-habilitar el botón si hay error de validación
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
        }
        return;
    }

    // Validar formato de fecha (DD/MM/AAAA)
    if (!/^\d{2}\/\d{2}\/\d{4}$/.test(fecha)) {
        if (window.AppState && AppState.addNotification) {
            AppState.addNotification('❌ Formato de fecha inválido. Use DD/MM/AAAA', 'error');
        }
        if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
        // 🔥 NUEVO: Re-habilitar el botón si hay error de validación
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
        }
        return;
    }

    // Validar que pesoMin <= pesoMax
    if (pesoMin > pesoMax) {
        if (window.AppState && AppState.addNotification) {
            AppState.addNotification('❌ El peso mínimo no puede ser mayor al máximo', 'error');
        }
        if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
        // 🔥 NUEVO: Re-habilitar el botón si hay error de validación
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
            submitBtn.style.opacity = '1';
            submitBtn.style.cursor = 'pointer';
        }
        return;
    }

      
    let exito;
    try {
        if (esEdicion) {
            exito = await actualizarTorneo({
                nombre, fecha, organizador, lugar, palenque,
                pesoMin, pesoMax, anillosEditables
            });
        } else {
            exito = await crearNuevoTorneo({
                nombre, fecha, organizador, lugar, palenque,
                pesoMin, pesoMax, anillosEditables
            });
        }
    } catch (error) {
        console.error("Error en crearTorneo:", error);
        exito = false;
    } finally {
        // 🔥 NUEVO: Re-habilitar el botón SIEMPRE al finalizar, independientemente del resultado
