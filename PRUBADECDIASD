  if (!AppState.firebase.database) {
    console.log("📦 Inicializando database en verificarDispositivo...");
    try {
      AppState.firebase.database = firebase.database();
    } catch (e) {
      console.error('❌ Error inicializando database:', e);
      return false;
    }
  }
  
  try {
    console.log('🔐 Verificando dispositivo para:', user.uid);
    
    const database = AppState.firebase.database;
    
    // 1. Obtener huella ACTUAL
    const currentDevice = await getDeviceFingerprint();
    
    // 2. Obtener perfil del usuario
    const userSnapshot = await database.ref('users/' + user.uid).once('value');
   
if (!userSnapshot.exists()) {
  console.log("📝 Usuario nuevo - perfil aún no creado, permitiendo registro");
  return true;  // ← SOLO CAMBIA false POR true
}

    
    const userProfile = userSnapshot.val();
    const maxDevices = userProfile.maxDevices || 1;
    
    // 3. Obtener dispositivos autorizados
    const devicesSnapshot = await database.ref(`dispositivos_autorizados/${user.uid}`).once('value');
    const authorizedDevices = devicesSnapshot.val() || {};
    
    // 4. Buscar si el dispositivo actual está autorizado
    const deviceExists = authorizedDevices[currentDevice.fingerprint];
    
    if (deviceExists) {
      // ✅ Dispositivo conocido
      console.log('✅ Dispositivo autorizado encontrado');
      
      await database.ref(`dispositivos_autorizados/${user.uid}/${currentDevice.fingerprint}/lastLogin`)
        .set(firebase.database.ServerValue.TIMESTAMP);
      
      return true;
      
    } else {
      // ❌ Dispositivo nuevo
      const devicesCount = Object.keys(authorizedDevices).length;
      
      if (devicesCount < maxDevices) {
        // ✅ Hay cupo
        console.log('➕ Nuevo dispositivo autorizado');
        
        await database.ref(`dispositivos_autorizados/${user.uid}/${currentDevice.fingerprint}`).set({
          fingerprint: currentDevice.fingerprint,
          firstSeen: firebase.database.ServerValue.TIMESTAMP,
          lastLogin: firebase.database.ServerValue.TIMESTAMP,
          verified: true,
          info: {
            gpu: currentDevice.components.gpu,
            cores: currentDevice.components.cores,
            resolution: currentDevice.components.resolution,
            os: currentDevice.components.os,
            architecture: currentDevice.components.arch
          },
          userAgent: currentDevice.userAgent
        });
        
        return true;
        
      } else {
       
        
    if (window._bloqueandoDispositivo) {
    console.log("🚫 Bloqueo ya en progreso, ignorando...");
    return false;
  }
  window._bloqueandoDispositivo = true;
  
  console.log('🚫 BLOQUEADO: Límite de dispositivos');
  
