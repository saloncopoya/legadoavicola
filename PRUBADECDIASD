  // === DATOS OPCIONALES (solo si existen) ===
  ...(partyName && { partyName }),
  ...(representative && { representative }),
  ...(municipioFinal && { municipio: municipioFinal })
});


// FORZAR CARGA DEL PERFIL INMEDIATAMENTE
