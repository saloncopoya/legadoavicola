// CARGA ÚNICA DE DATOS GLOBALES (PALENQUES, PARTIDOS, COLORES)
// ==============================================
let datosGlobalesCargados = false;
let datosGlobalesPromise = null;

async function cargarDatosGlobales(forceRefresh = false) {
  if (!forceRefresh && datosGlobalesCargados && window.__globalData) {
    console.log("📦 Datos globales ya cargados, reutilizando");
    return window.__globalData;
  }
  if (datosGlobalesPromise) {
    console.log("⏳ Esperando carga en curso...");
    return datosGlobalesPromise;
  }
  datosGlobalesPromise = (async () => {
    try {
      const cached = AppState.persistentCache.getGlobal('globalData');
      if (!forceRefresh && cached) {
        console.log("✅ Datos globales cargados desde localStorage (30 días)");
        window.__globalData = cached;
        datosGlobalesCargados = true;
        return cached;
      }
      console.log("🌐 Cargando datos globales desde Firebase...");
      const db = getAdminDatabase();
      if (!db) throw new Error("No se pudo conectar a Firebase");
      const [palenquesSnap, partidosSnap, coloresSnap] = await Promise.all([
        db.ref('PALENQUES').once('value'),
        db.ref('NOMPARTIDOS').once('value'),
        db.ref('COLORGALLOS').once('value')
      ]);
      const palenques = [];
      if (palenquesSnap.exists()) {
        Object.values(palenquesSnap.val()).forEach(item => {
          if (item && item.nombre) palenques.push(item.nombre);
          else if (typeof item === 'string') palenques.push(item);
        });
      }
      const partidos = [];
      if (partidosSnap.exists()) {
        Object.values(partidosSnap.val()).forEach(item => {
          if (item && item.nombre) partidos.push(item.nombre);
          else if (typeof item === 'string') partidos.push(item);
        });
      }
      const colores = [];
      if (coloresSnap.exists()) {
        Object.values(coloresSnap.val()).forEach(item => {
          if (item && item.nombre) colores.push(item.nombre);
          else if (typeof item === 'string') colores.push(item);
        });
      }
      const globalData = { palenques, partidos, colores };
      AppState.persistentCache.setGlobal('globalData', globalData);
      window.__globalData = globalData;
      datosGlobalesCargados = true;
      console.log(`✅ Datos globales guardados: ${palenques.length} palenques, ${partidos.length} partidos, ${colores.length} colores`);
      return globalData;
    } catch (error) {
      console.error("❌ Error cargando datos globales:", error);
      window.__globalData = { palenques: [], partidos: [], colores: [] };
      return window.__globalData;
    } finally {
      datosGlobalesPromise = null;
    }
  })();
  return datosGlobalesPromise;
}

 
