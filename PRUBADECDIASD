   const renderPosts = (posts, highlightPost = null) => {
    const container = document.getElementById('posts-container');
    if (!container) return;
    
    // 🔥 GENERAR HASH DE LOS POSTS
    const hashActual = posts.map(post => {
        const calif = post.likesList ? Object.keys(post.likesList).length : 0;
        return `${post.id}|${post.descripcion}|${post.nombreTorneo}|${post.fechaTorneo}|${post.likes || 0}|${post.commentsCount || 0}|${post.sharesCount || 0}|${calif}`;
    }).join('|');
    
    // Si no cambió, usar HTML guardado
    if (hashActual === ultimoHashPosts && ultimoHTMLPosts) {
        console.log("⏭️ [SHARE] Posts sin cambios, usando caché");
        container.innerHTML = ultimoHTMLPosts;
        return;
    }
    
    ultimoHashPosts = hashActual;
    
    // ===== TU CÓDIGO ORIGINAL COMIENZA AQUÍ =====
    let filteredPosts = posts;
    if (currentFilter === 'withDate') {
        filteredPosts = posts.filter(p => p.nombreTorneo && p.nombreTorneo.trim() !== '' && p.fechaTorneo && p.fechaTorneo.trim() !== '');
    }
    
    if (filteredPosts.length === 0) {
        const htmlVacio = `
            <div style="text-align:center;padding:60px;background:white;border-radius:12px;">
                <div style="font-size:48px;margin-bottom:16px;">📭</div>
