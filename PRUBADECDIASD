  const currentUser = AppState.user.current;
  const database = AppState.firebase.database;
  
  if (!currentUser || !database) { 
    AppState.addNotification('No hay usuario logueado', 'error');
    return; 
  }
  
  try {
    const snapshot = await database.ref('users/' + currentUser.uid + '/activated').once('value');
    if (snapshot.val() === true) {
      AppState.addNotification('✅ ¡Cuenta activada!', 'success');
      
      // Recargar perfil para obtener el estado actualizado
      await loadUserProfile(currentUser.uid);
      
      setTimeout(() => {
  // Recuperar intención guardada (si existe)
  const intencionGuardada = sessionStorage.getItem('postActivationIntent');
  sessionStorage.removeItem('postActivationIntent'); // Limpiar
  
  // Lista de pantallas permitidas (INCLUYE juez)
  const pantallasPermitidas = ['public', 'rooster', 'publicaciones', 'pedigri', 'juez', 'ventas', 'perfil', 'configuraciones'];
  
  if (intencionGuardada && pantallasPermitidas.includes(intencionGuardada)) {
    // Si había una intención guardada, ir a esa pantalla
    AppState.setScreen(intencionGuardada);
    window.history.pushState({}, '', `/?section=${intencionGuardada}`);
  } else {
    // Si no, ir a rooster por defecto
    AppState.setScreen('public');
    window.history.pushState({}, '', '/?section=public');
  }
}, 1500);



    } else { 
      AppState.addNotification('⏳ Tu cuenta aún no ha sido activada', 'warning');
    }
  } catch (error) { 
    console.error('❌ Error verificando estado:', error); 
    AppState.addNotification('Error al verificar estado de activación', 'error');
  }
}


