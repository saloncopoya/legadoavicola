// SISTEMA DE NOTIFICACIONES MEJORADO (Toast)
// ==============================================
addNotification(message, type = 'info', duration = 5000) {
  // Log de depuración
  console.log(`🔔 NOTIFICACIÓN [${type}] desde:`, {
    mensaje: message,
    tipo: type,
    timestamp: new Date().toISOString(),
    stack: new Error().stack.split('\n').slice(1, 4)
  });

  const container = document.getElementById('toast-container');
  if (!container) return;

  // 1. Crear el elemento de la notificación
  const toast = document.createElement('div');
  toast.className = `toast-message toast-${type}`; // Esto ahora también soporta 'toast-blue'
  toast.textContent = message;

  // 2. Hacer que desaparezca al hacer clic (usando la nueva animación)
  toast.addEventListener('click', function() {
    // Si ya está en proceso de eliminación, no hacer nada
    if (this.classList.contains('fade-out')) return;
    
    this.classList.add('fade-out');
    // Eliminar el elemento del DOM después de la animación
    setTimeout(() => {
      if (this.parentNode) this.parentNode.removeChild(this);
    }, 250); // Coincide con la duración de fadeOutClean
  });

  // 3. Agregar al final del contenedor
  container.appendChild(toast);

  // 4. Programar la desaparición automática
  const timeoutId = setTimeout(() => {
    // Verificar si el elemento sigue existiendo y no ha sido eliminado ya por un clic
    if (toast.parentNode && !toast.classList.contains('fade-out')) {
      toast.classList.add('fade-out');
      setTimeout(() => {
        if (toast.parentNode) toast.parentNode.removeChild(toast);
      }, 250);
    }
  }, duration);

  // 5. (Opcional pero recomendado) Guardar el timeout en el elemento para poder cancelarlo si es necesario
  toast._timeoutId = timeoutId;
},

  // Método para suscribir la UI
  subscribers: [],
  subscribe(callback) {
    this.subscribers.push(callback);
  },
  


  notify(propriedadCambiada) {
    if (this._isNotifying) return;
    this._isNotifying = true;
    try {
      this.subscribers.forEach(callback => {
        try {
          callback(propriedadCambiada);
        } catch(e) { console.error("Error en callback:", e); }
      });
  } finally {
    this._isNotifying = false;
  }
}

};


