// Función para verificar si el usuario ya solicitó este partido en esta tabla
async function verificarSolicitudExistente(uidUsuario, idTabla, nombrePartido, nombreColumna) {
    if (!ventasDb) return null;
    
    try {
        const snapshot = await ventasDb.ref(`SubastaSolicitud/${idTabla}/${nombrePartido}/${nombreColumna}/${uidUsuario}`).once('value');
        if (snapshot.exists()) {
            const data = snapshot.val();
            return {
                existe: true,
                fecha: data.fechaEnvio,
                fechaLegible: new Date(data.fechaEnvio).toLocaleString()
            };
        }
        return { existe: false };
    } catch (error) {
        console.error("Error verificando solicitud:", error);
        return { existe: false };
    }
}

// Función para guardar la solicitud en Firebase
async function guardarSolicitudFirebase(datos) {
    if (!ventasDb) return false;
    
    try {
        const { idTabla, nombrePartido, nombreColumna, uidUsuario, nombreUsuario, monto, nombrePartidoEscrito, nombreTorneo, fechaTorneo } = datos;
        
        const ref = ventasDb.ref(`SubastaSolicitud/${idTabla}/${nombrePartido}/${nombreColumna}/${uidUsuario}`);
        
        await ref.set({
            uid: uidUsuario,
            nombreUsuario: nombreUsuario,
    nombrePartido: nombrePartido,
            nombreColumna: nombreColumna,
            monto: monto,
            fechaEnvio: Date.now()
        });
        
        console.log("✅ Solicitud guardada en Firebase");
        return true;
    } catch (error) {
        console.error("❌ Error guardando en Firebase:", error);
        return false;
    }
}

async function obtenerTelefonoCreadorTabla(uidCreador, idTabla) {
    if (!ventasDb) return null;
    
    try {
        console.log(`📞 Buscando teléfono en: VENTAS/${uidCreador}/${idTabla}/telefonoCreador`);
        
        // Buscar el teléfono DENTRO de la tabla
        const snapshot = await ventasDb.ref(`VENTAS/${uidCreador}/${idTabla}`).once('value');
        
        if (snapshot.exists()) {
            const tabla = snapshot.val();
            let telefono = tabla.telefonoCreador;
            
            console.log(`📞 Datos de la tabla encontrada:`, {
                titulo: tabla.titulo,
                telefonoCreador: telefono,
                tieneTelefono: !!telefono
            });
            
            if (telefono) {
                let telefonoLimpio = String(telefono).replace(/\D/g, '');
                console.log(`📞 Teléfono original: ${telefono}, limpio: ${telefonoLimpio}`);
                
                if (telefonoLimpio.length === 10) {
                    telefonoLimpio = '52' + telefonoLimpio;
                }
                
                if (telefonoLimpio.length >= 10) {
                    return telefonoLimpio;
                }
            }
        }
        
        console.error(`📞 No se encontró teléfono en la tabla ${idTabla}`);
        return null;
        
    } catch (error) {
        console.error("Error obteniendo teléfono:", error);
        return null;
    }
}


