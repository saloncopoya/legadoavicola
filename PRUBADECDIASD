// Función para generar JPG - VERSIÓN ORIGINAL QUE FUNCIONA
window.generarJPGPublic = async function(torneoId, torneoNombre) {
    // Buscar la tarjeta completa del torneo
    const tarjetaCompleta = document.querySelector(`#torneo-${torneoId}`)?.closest('div[style*="margin-bottom: 60px;"]');
    if (!tarjetaCompleta) {
        if (window.AppState) AppState.addNotification('❌ No se encontró el torneo', 'error');
        return;
    }
    
    // ===== DETECTAR QUÉ PESTAÑA ESTÁ ACTIVA =====
    let esCotejo = false;
    let esPosicion = false;
    
    const botonesPestanas = tarjetaCompleta.querySelectorAll('button[onclick*="cambiarPestanaPublic"]');
    botonesPestanas.forEach(btn => {
        const estiloBg = btn.style.background;
        if (estiloBg === '#8B4513' || estiloBg === 'rgb(139, 69, 19)') {
            if (btn.textContent.includes('COTEJO')) {
                esCotejo = true;
            } else if (btn.textContent.includes('POSICIONES')) {
                esPosicion = true;
            }
        }
    });
    
    if (!esCotejo && !esPosicion) esPosicion = true;
    const tipoContenido = esCotejo ? 'COTEJO' : 'POSICIONES';
    
    if (window.AppState) AppState.addNotification(`📸 Generando imagen de ${tipoContenido}...`, 'info');
    
    // ===== CLONAR LA TARJETA COMPLETA =====
    const clone = tarjetaCompleta.cloneNode(true);
    
    // Eliminar botones de acción
    const botonesAccion = clone.querySelectorAll('button');
    botonesAccion.forEach(btn => {
        if (btn.textContent.includes('VER') || btn.textContent.includes('COMPARTIR')) {
            btn.remove();
        }
    });
    
    // Eliminar indicador de tiempo real
    const indicadorTiempo = clone.querySelector('div[style*="padding: 8px 16px; background: #f0f8ff"]');
    if (indicadorTiempo) indicadorTiempo.remove();
    
    // ===== OCULTAR LA PESTAÑA QUE NO ESTÁ ACTIVA =====
    const contenedorPestanas = clone.querySelector('div[style*="display: flex; gap: 12px; justify-content: center"]');
    if (contenedorPestanas) {
        const botones = contenedorPestanas.querySelectorAll('button');
        botones.forEach(btn => {
            if (esCotejo && btn.textContent.includes('POSICIONES')) {
                btn.style.display = 'none';
            } else if (esPosicion && btn.textContent.includes('COTEJO')) {
                btn.style.display = 'none';
            }
        });
    }
    
    // ===== MOSTRAR SOLO EL CONTENIDO DE LA PESTAÑA ACTIVA =====
    const contenedoresContenido = clone.querySelectorAll('div[style*="overflow-x: auto;"]');
    contenedoresContenido.forEach(contenedor => {
        const tablas = contenedor.querySelectorAll('table');
        tablas.forEach(tabla => {
            const esTablaPosicion = tabla.textContent.includes('Partido') && tabla.textContent.includes('Puntos');
            if (esPosicion && esTablaPosicion) {
                tabla.style.display = 'table';
            } else if (esCotejo && !esTablaPosicion) {
                tabla.style.display = 'table';
            } else {
                tabla.style.display = 'none';
            }
        });
    });
    

    // AGREGAR LEYENDA
    const leyendaDiv = document.createElement('div');
    leyendaDiv.style.cssText = 'text-align:center;font-size:7px;font-weight:600;background:#f0f0f0;padding:3px;border-radius:53px;margin:5px 0 10px;border:1px solid #ddd;';
    leyendaDiv.textContent = 'COTEJO COMPUTARIZADO: 961 115 03 94 LEGALIDAD QUE RESPALDA TU PASIÓN - IMPARCIALIDAD ABSOLUTA EN CADA DATO';
    clone.insertBefore(leyendaDiv, clone.firstChild.nextSibling);



    // Estilos para la captura (SIN LOGO, SIN LEYENDA - COMO ORIGINAL)
    clone.style.width = '100%';
    clone.style.backgroundColor = 'white';
    clone.style.padding = '15px';
    clone.style.borderRadius = '0';
    clone.style.boxSizing = 'border-box';
    
    // Asegurar colores en las tablas
    const tablas = clone.querySelectorAll('table');
    tablas.forEach(tabla => {
        tabla.style.width = '100%';
        tabla.style.borderCollapse = 'collapse';
        
        const celdasCabecera = tabla.querySelectorAll('th');
        celdasCabecera.forEach(th => {
            if (esCotejo) {
                if (th.textContent.includes('CINTA ROJA')) {
                    th.style.backgroundColor = '#d32f2f';
                } else if (th.textContent.includes('CINTA VERDE')) {
                    th.style.backgroundColor = '#4CAF50';
                } else {
                    th.style.backgroundColor = '#333333';
                }
            } else {
                th.style.backgroundColor = '#8B4513';
            }
            th.style.color = 'white';
            th.style.padding = '4px 3px';
            th.style.border = '1px solid #a0522f';
        });
        
        const celdasCuerpo = tabla.querySelectorAll('td');
        celdasCuerpo.forEach(td => {
            td.style.padding = '3px 3px';
            td.style.border = '1px solid #ddd';
        });
        
        if (esCotejo) {
            const celdasRojo = tabla.querySelectorAll('.bg-rojo');
            celdasRojo.forEach(celda => {
                celda.style.backgroundColor = '#d32f2f';
                celda.style.color = 'white';
            });
            const celdasVerde = tabla.querySelectorAll('.bg-verde');
            celdasVerde.forEach(celda => {
                celda.style.backgroundColor = '#4CAF50';
                celda.style.color = 'white';
            });
        }
    });
    
    // Crear contenedor temporal
    const container = document.createElement('div');
    container.style.cssText = 'position:fixed;top:-9999px;left:-9999px;background:white;padding:15px;display:inline-block;';
    container.appendChild(clone);
    document.body.appendChild(container);
    
    await new Promise(r => setTimeout(r, 300));
    
    try {
        const canvas = await html2canvas(container, { 
            scale: 2.5, 
            backgroundColor: '#ffffff',
            logging: false,
            useCORS: false
        });
        const link = document.createElement('a');
        const nombreArchivo = `${torneoNombre.replace(/[^a-z0-9]/gi, '_')}_${esCotejo ? 'cotejo' : 'posiciones'}_${Date.now()}.jpg`;
        link.download = nombreArchivo;
        link.href = canvas.toDataURL('image/jpeg', 0.95);
        link.click();
        if (window.AppState) AppState.addNotification('✅ Imagen guardada', 'success');
    } catch(e) {
        console.error(e);
        if (window.AppState) AppState.addNotification('❌ Error al generar imagen', 'error');
    } finally {
        document.body.removeChild(container);
    }
};



