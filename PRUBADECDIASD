async function handleCompleteRegister() {

 console.log("🟩 BOTÓN CREAR CUENTA presionado desde:", {
    funcion: "handleCompleteRegister",
    nombre: document.getElementById('registerFullName')?.value || "vacío",
    email: document.getElementById('registerRealEmail')?.value || "vacío",
    timestamp: new Date().toISOString()
  });


  // ===== NUEVA LÓGICA: Si no hay token, lo generamos ahora =====
  const formName = 'register';
  let storedToken = sessionStorage.getItem(`csrf_${formName}`);
  let expiry = sessionStorage.getItem(`csrf_${formName}_expiry`);

  if (!storedToken || Date.now() > parseInt(expiry)) {
    console.log("🔄 Generando nuevo token CSRF para registro");
    // Generar token nuevo
    const array = new Uint32Array(4);
    window.crypto.getRandomValues(array);
    storedToken = Array.from(array, dec => ('0' + dec.toString(16)).substr(-8)).join('');
    
    sessionStorage.setItem(`csrf_${formName}`, storedToken);
    sessionStorage.setItem(`csrf_${formName}_expiry`, Date.now() + 3600000);
  } else {
    console.log("✅ Token CSRF válido encontrado");
  }
  
  // ===== YA NO ELIMINAMOS EL TOKEN AQUÍ =====
  // sessionStorage.removeItem(`csrf_${formName}`);  ← ESTO ESTABA CAUSANDO EL PROBLEMA
  // sessionStorage.removeItem(`csrf_${formName}_expiry`); ← NO ELIMINAR

  const ipKey = 'register_attempts';
  if (!RateLimiter.canAttempt(ipKey, 3, 3600000)) {
    AppState.addNotification('❌ Has excedido el límite de registros. Intenta más tarde.', 'error');
    return;
  }

  // Validar que Firebase esté activado
  if (!AppState.firebase.isEnabled) {
    AppState.addNotification('Firebase no está inicializado. Intenta de nuevo.', 'error');
    return;
  }
  
  const btn = document.getElementById('registerSubmitBtn');
  const errorDiv = document.getElementById('registerError');
  const successDiv = document.getElementById('registerSuccess');



  const fullName = sanitizarInput(document.getElementById('registerFullName')?.value || '');
  const partyName = sanitizarInput(document.getElementById('registerPartyName')?.value || '');
  const representative = sanitizarInput(document.getElementById('registerRepresentative')?.value || '');
  const municipioSelect = document.getElementById('registerMunicipio');
  const customMunicipio = sanitizarInput(document.getElementById('registerCustomMunicipio')?.value || '');

  const phonePrefix = document.getElementById('registerPhonePrefix')?.value || '+52 961';
  const phoneNumber = document.getElementById('registerPhone')?.value.trim() || '';
  const password = document.getElementById('registerPassword')?.value || '';
  const confirmPassword = document.getElementById('registerConfirmPassword')?.value || '';
  const termsAccepted = document.getElementById('registerTerms')?.checked || false;
  const realEmail = document.getElementById('registerRealEmail')?.value.trim() || '';
  
  if (errorDiv) errorDiv.textContent = '';
  if (successDiv) successDiv.textContent = '';

  // Validaciones
  if (!fullName) { 
    AppState.addNotification('Nombre completo requerido', 'error');
    return; 
  }
  
  if (!realEmail) { 
    AppState.addNotification('Email real requerido para recuperación de contraseña', 'error');
    return; 
  }
  
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(realEmail)) { 
    AppState.addNotification('Email inválido. Usa un email real como: ejemplo@gmail.com', 'error');
    return; 
  }

  // Procesar municipio
  let municipioFinal = '';
