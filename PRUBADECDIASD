window.toggleUserGallo = async function(uid, setGallo) {
  // ===== PASO 1: OBTENER REFERENCIAS (TUS VARIABLES ORIGINALES) =====
  const currentUser = AppState.user.current;
  const database = AppState.firebase.database;
  const userProfile = AppState.user.profile;
  const currentScreen = AppState.ui.currentScreen;  // ← ESTA SÍ, NO LA ELIMINES


  // ===== PASO 3: VALIDACIÓN INICIAL (TU CÓDIGO ORIGINAL) =====
  if (!currentUser || !database || !userProfile) {
    AppState.addNotification('❌ Debes iniciar sesión', 'error');
    return;
  }

  // Verificar si es admin (primera validación rápida)
  if (userProfile.gallo !== true) {
    AppState.addNotification('❌ No tienes permisos de administrador', 'error');
    return;
  }

  // ===== PASO 4: VALIDAR QUE EL UID SEA VÁLIDO =====
  if (!uid || typeof uid !== 'string') {
    AppState.addNotification('❌ ID de usuario inválido', 'error');
    return;
  }

  // ===== PASO 5: VERIFICACIÓN EXTRA DESDE FIREBASE (¡NUEVA Y CRÍTICA!) =====
  try {
    console.log(`🔐 Verificando permisos de admin para: ${currentUser.uid}`);
    
    // Consultar DIRECTAMENTE a Firebase si SIGUE siendo admin
    const adminSnapshot = await database
      .ref(`users/${currentUser.uid}/gallo`)
      .once('value');
    
    // Si ya no es admin (otro admin lo desactivó), cancelamos TODO
    if (adminSnapshot.val() !== true) {
      AppState.addNotification('❌ Tus permisos de admin han sido revocados', 'error');
      return;
    }

    // ===== PASO 6: VERIFICAR QUE EL USUARIO DESTINO EXISTE =====
    const targetUserSnapshot = await database
      .ref(`users/${uid}`)
      .once('value');
    
    if (!targetUserSnapshot.exists()) {
      AppState.addNotification('❌ El usuario destino no existe', 'error');
      return;
    }

    // ===== PASO 7: EJECUTAR LA ACCIÓN (TU CÓDIGO ORIGINAL MEJORADO) =====
    console.log(`✅ Admin verificado. Cambiando gallo de ${uid} a ${setGallo}`);
    
    await database.ref(`users/${uid}/gallo`).set(setGallo);
    
    // ===== PASO 8: NOTIFICACIÓN DE ÉXITO =====
    AppState.addNotification(
      `✅ Usuario ${setGallo ? 'ahora es ADMIN' : 'ya no es admin'}`, 
      'success'
    );

    // ===== PASO 9: ACTUALIZAR LA VISTA SI ES NECESARIO (TU CÓDIGO) =====
    if (currentScreen === 'admin') {
      console.log('🔄 Recargando panel admin...');
      renderApp();
    }

    // ===== PASO 10: SI EL USUARIO SE MODIFICÓ A SÍ MISMO, ACTUALIZAR AppState =====
    if (uid === currentUser.uid) {
      console.log('👤 El admin se modificó a sí mismo, actualizando perfil...');
      
      // Forzar recarga del perfil
      setTimeout(async () => {
        const freshSnapshot = await database.ref('users/' + currentUser.uid).once('value');
        if (freshSnapshot.exists()) {
          const freshProfile = { id: currentUser.uid, ...freshSnapshot.val() };
          AppState.setUser(currentUser, freshProfile);
        }
      }, 500);
    }

  } catch (error) {
    // ===== PASO 11: MANEJO DE ERRORES MEJORADO =====
    console.error('❌ Error DETALLADO en toggleUserGallo:', {
      error: error,
      code: error.code,
      message: error.message,
      uid: uid,
      setGallo: setGallo
    });
    
    // Mensaje amigable según el error
    let errorMessage = 'Error al cambiar rol';
    if (error.code === 'PERMISSION_DENIED') {
      errorMessage = '❌ No tienes permiso para esta acción';
    } else if (error.code === 'NETWORK_ERROR') {
      errorMessage = '❌ Error de red. Verifica tu conexión';
    }
    
    AppState.addNotification(errorMessage, 'error');
  }
};






