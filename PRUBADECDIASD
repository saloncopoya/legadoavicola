// Función auxiliar local para escapar HTML
const escapeHTML = (str) => {
    if (!str) return '';
    return String(str).replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
};


window.descargarJPGVentas = async function(tablaId) {
    const contenedor = document.querySelector('#ventas-main-container');
    if (!contenedor) {
        if (window.AppState) AppState.addNotification('No se encontró el contenido', 'error');
        return;
    }
    if (window.AppState) AppState.addNotification('Espera 📸 Generando imagen...', 'info');
    
    // Buscar el div que contiene el título, la información del evento y la tabla
    let contentDiv = contenedor.querySelector('div[style*="border-top:1px solid #eee"][style*="border-bottom:1px solid #eee"]');
    if (!contentDiv) {
        // Fallback: buscar el div que contiene el h2 (título)
        const h2 = contenedor.querySelector('h2');
        if (h2 && h2.parentElement) contentDiv = h2.parentElement;
    }
    if (!contentDiv) {
        if (window.AppState) AppState.addNotification('No se encontró la tabla', 'error');
        return;
    }
    
    // Clonar el contenido
    const pagina = contentDiv.cloneNode(true);
    
    // Eliminar el footer (Creado: ...)
    const footerDiv = pagina.querySelector('div[style*="margin-top:20px"]');
    if (footerDiv) footerDiv.remove();
    
    // Eliminar imágenes problemáticas (opcional)
    const todasLasImagenes = pagina.querySelectorAll('img');
    todasLasImagenes.forEach(img => img.remove());
    
    // Crear contenedor temporal
    const container = document.createElement('div');
    container.style.cssText = 'position:fixed;top:-9999px;left:-9999px;background:white;padding:20px;width:auto;display:inline-block;';
    document.body.appendChild(container);
    
    pagina.style.width = '100%';
    pagina.style.backgroundColor = 'white';
    
    // Ajustar tabla (opcional, pero mantiene el estilo)
    const tablaClone = pagina.querySelector('table');
    if (tablaClone) {
        tablaClone.style.width = '100%';
        tablaClone.style.borderCollapse = 'collapse';
        tablaClone.querySelectorAll('th, td').forEach(c => {
            c.style.padding = '8px 6px';
            c.style.border = '1px solid #ddd';
        });
        tablaClone.querySelectorAll('th').forEach(th => {
            th.style.backgroundColor = '#8B4513';
            th.style.color = 'white';
        });
    }
    
    container.appendChild(pagina);
    await new Promise(r => setTimeout(r, 300));
    
    try {
        const canvas = await html2canvas(container, { 
            scale: 2, 
            backgroundColor: '#ffffff',
            useCORS: false,
            logging: false
        });
        const link = document.createElement('a');
        link.download = `tabla_${tablaId}_${Date.now()}.jpg`;
        link.href = canvas.toDataURL('image/jpeg', 1.0);
        link.click();
        if (window.AppState) AppState.addNotification('✅ Imagen guardada', 'success');
    } catch(e) {
        console.error(e);
        if (window.AppState) AppState.addNotification('❌ Error al generar imagen', 'error');
    } finally {
        document.body.removeChild(container);
    }
};


