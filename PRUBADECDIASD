    const guardarTabla = async () => {
    const titulo = document.getElementById('ventas-titulo').value.trim();

    let fecha = document.getElementById('ventas-fecha').value.trim();
// Convertir de YYYY-MM-DD a DD/MM/AAAA
if (fecha && fecha.includes('-')) {
    const [anio, mes, dia] = fecha.split('-');
    fecha = `${dia}/${mes}/${anio}`;
}
const palenque = document.getElementById('ventas-palenque').value.trim();
    const organizador = document.getElementById('ventas-organizador').value.trim();
    const telefono = document.getElementById('ventas-telefono')?.value.trim() || '';
    
    // Validaciones
    if (!titulo || !fecha || !palenque) {
        AppState.addNotification('Todos los campos del encabezado son obligatorios', 'error');
        return false;
    }
    
    if (!telefono || telefono.length !== 10 || !/^\d+$/.test(telefono)) {
        AppState.addNotification('Debes ingresar un número de WhatsApp válido de 10 dígitos', 'error');
        return false;
    }
    
    let exito = false;
    let tablaIdGuardada = null;
    
    // Caso 1: Estamos EDITANDO una tabla existente
    if (tablaDetalle && tablaDetalle.createdBy === uid) {
        exito = await actualizarTablaVentas(tablaDetalle.id, {
            titulo, fecha, palenque, organizador,
            partidos: partidosEditor.filter(p => p.nombre && p.nombre.trim() !== ''),
            columnas: columnasEditor
        });
        if (exito) {
            tablaIdGuardada = tablaDetalle.id;
        }
    } 
    // Caso 2: Estamos CREANDO una tabla NUEVA
    else {
        exito = await guardarTablaVentas({
            titulo, fecha, palenque, organizador, telefono,
            partidos: partidosEditor.filter(p => p.nombre && p.nombre.trim() !== ''),
            columnas: columnasEditor
        });
        
        // <-- NUEVO: Obtener el ID de la tabla recién creada
        if (exito && tablasVentas.length > 0) {
            // Buscar la tabla más reciente creada por este usuario
            const tablaReciente = tablasVentas
                .filter(t => t.createdBy === uid)
                .sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0))[0];
            if (tablaReciente) {
                tablaIdGuardada = tablaReciente.id;
                console.log(`✅ Tabla creada con ID: ${tablaIdGuardada}`);
            }
        }
    }
    
    // <-- NUEVO: Si la operación fue exitosa, mostrar la tabla en modo cliente
    if (exito && tablaIdGuardada) {
        // Limpiar el editor
        limpiarEditor();
        
        // Buscar la tabla actualizada en tablasVentas
        const tablaActualizada = tablasVentas.find(t => t.id === tablaIdGuardada);
        
        if (tablaActualizada) {
            // Establecer como tablaDetalle para verla
            tablaDetalle = tablaActualizada;
            
            // Asegurar que el porcentaje de descuento se cargue
            if (tablaActualizada.descuento !== undefined && tablaActualizada.descuento > 0) {
                porcentajeDescuento = tablaActualizada.descuento;
            } else {
                porcentajeDescuento = 0;
            }
            
            // Cambiar a modo cliente para ver la tabla
            modoVista = 'cliente';
            
            // Renderizar la vista con la tabla abierta
            renderUI();
            
            
            
            // Scroll suave hacia arriba para ver la tabla
            setTimeout(() => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }, 100);
        } else {
            // Fallback: si no encuentra la tabla, solo mostrar lista
            limpiarEditor();
            tablaDetalle = null;
            modoVista = 'cliente';
            renderUI();
        }
    } else if (exito) {
        // Si hubo éxito pero no tenemos ID (caso raro)
        limpiarEditor();
        tablaDetalle = null;
        modoVista = 'cliente';
        renderUI();
    }
};
    


