    const guardarTabla = async () => {
    const titulo = document.getElementById('ventas-titulo').value.trim();

    let fecha = document.getElementById('ventas-fecha').value.trim();
// Convertir de YYYY-MM-DD a DD/MM/AAAA
if (fecha && fecha.includes('-')) {
